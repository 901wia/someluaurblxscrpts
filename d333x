    local function functionSummary901(fn,label)
        if type(fn)~="function" then return tostring(label).." = <non-function>" end
        local out={"FUNCTION: "..tostring(label)}
        local getinfo=api901("getinfo")
        if getinfo and Settings.ReverseEngineering.ShowFunctionInfo then
            local ok,info=pcall(getinfo,fn)
            out[#out+1]="INFO\n"..(ok and inspect901(info) or "ERROR: "..tostring(info))
        end
        local specs={
            {"CONSTANTS","getconstants","getconstant"},
            {"UPVALUES","getupvalues","getupvalue"},
            {"PROTOTYPES","getprotos","getproto"}
        }
        for _,sp in ipairs(specs) do
            local title,allName,oneName=sp[1],sp[2],sp[3]
            if (title=="CONSTANTS" and not Settings.ReverseEngineering.ShowConstants) or
               (title=="UPVALUES" and not Settings.ReverseEngineering.ShowUpvalues) or
               (title=="PROTOTYPES" and not Settings.ReverseEngineering.ShowPrototypes) then
                continue
            end
            local all=api901(allName)
            if all then
                local ok,val=pcall(all,fn)
                out[#out+1]=title
                if ok then
                    if type(val)=="table" then
                        local indexes={}
                        for k in pairs(val) do if type(k)=="number" then indexes[#indexes+1]=k end end
                        table.sort(indexes)
                        local one=api901(oneName)
                        for _,idx in ipairs(indexes) do
                            local vok,v=one and pcall(one,fn,idx) or false,val[idx]
                            out[#out+1]="  ["..idx.."] = "..inspect901(vok and v or val[idx])
                        end
                    else
                        out[#out+1]="  "..inspect901(val)
                    end
                else
                    out[#out+1]="  ERROR: "..tostring(val)
                end
            end
        end
        if Settings.ReverseEngineering.ShowDisassembly then
            local dis=api901("disassemble")
            if dis then
                local ok,val=pcall(dis,fn,{Recursive=Settings.ReverseEngineering.DisassembleRecursive,ShowLines=true,ShowConstants=true,StringPreviewMax=256})
                out[#out+1]="DISASSEMBLY\n"..(ok and tostring(val) or "ERROR: "..tostring(val))
            end
        end
        return table.concat(out,"\n\n")
    end

