		local roots = nodes or {}
		if #roots == 0 then return false, "No selection" end
		local window, holder = Main.CreateToolWindow(includeChildren and "Copy All Properties + Children" or "Copy Properties", 520, 190)
		local status = Instance.new("TextLabel")
