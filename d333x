    local function scriptRelativePath901(scriptObj)
        local parts = {}
        local current = scriptObj
        while current and current ~= game do
            table.insert(parts,1,safePathComponent901(current.Name))
            local parent = current.Parent
            if not parent or parent == game then break end
            current = parent
        end
        local filename = table.remove(parts) or "Script"
        local folder = #parts > 0 and table.concat(parts,"/") or "Root"
        return "dex/decompiled/"..folder.."/"..filename..".luau"
    end

    Explorer.DecompileSelected = function()
        local roots = {}
        for _,node in ipairs((Explorer.Selection and Explorer.Selection.List) or {}) do
            if node and node.Obj then roots[#roots+1] = node.Obj end
        end
        local scripts = {}
        local seen = {}
        local function collect(obj)
            if not obj or typeof(obj) ~= "Instance" then return end
            if obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
                local full = obj:GetFullName()
                if not seen[full] then
                    seen[full] = true
                    scripts[#scripts+1] = obj
                end
            end
            for _,desc in ipairs(obj:GetDescendants()) do
                if desc:IsA("LocalScript") or desc:IsA("ModuleScript") then
                    local full = desc:GetFullName()
                    if not seen[full] then
                        seen[full] = true
                        scripts[#scripts+1] = desc
                    end
                end
            end
        end
        for _,root in ipairs(roots) do collect(root) end

        if #scripts == 0 then
            showViewer901("Viewer · Decompile","No LocalScript or ModuleScript exists in the selected instance tree.")
            return
        end

        local decompiler = DecompileScript
        local writer = safeEnvFn901("writefile")
        local makefolderFn = safeEnvFn901("makefolder")
        if type(decompiler) ~= "function" or type(writer) ~= "function" then
            showViewer901("Viewer · Decompile","The required decompiler or workspace writer is unavailable.")
            return
        end
        if type(makefolderFn) == "function" then
            pcall(makefolderFn,"dex")
            pcall(makefolderFn,"dex/decompiled")
        end

        local report = {"DECOMPILED SCRIPTS", ""}
        local count = 0
        for _,scriptObj in ipairs(scripts) do
            local ok,source = pcall(decompiler,scriptObj)
            if ok and type(source) == "string" and source ~= "" then
                local path = scriptRelativePath901(scriptObj)
                local folder = path:match("^(.*)/[^/]+$")
