    local function apiV5(name)
        local fn = env and env[name]
        if type(fn) == "function" then return fn end
        local ok, g = pcall(function() return rawget(_G, name) end)
        if ok and type(g) == "function" then return g end
        return nil
    end

    local function dumpV5(value, depth, seen)
        depth = depth or 0
        seen = seen or {}
        if depth > 5 then return "<depth-limit>" end
        local valueType = typeof(value)
        if valueType == "Instance" then
            local ok, full = pcall(function() return value:GetFullName() end)
            return ok and tostring(full) or tostring(value)
        end
        if type(value) == "string" then
            return string.format("%q", value)
        end
        if type(value) ~= "table" then
            return tostring(value)
        end
        if seen[value] then return "<cycle>" end
        seen[value] = true
        local keys = {}
        for k in pairs(value) do keys[#keys + 1] = k end
        table.sort(keys, function(a,b) return tostring(a) < tostring(b) end)
        local out = {"{"}
        for _,k in ipairs(keys) do
            out[#out + 1] = string.rep("  ", depth + 1)..tostring(k).." = "..dumpV5(value[k], depth + 1, seen)
        end
        out[#out + 1] = string.rep("  ", depth).."}"
        seen[value] = nil
        return table.concat(out, "\n")
    end

    local function selectedScriptV5(objects)
        for _, obj in ipairs(objects or {}) do
            if obj and (obj:IsA("LocalScript") or obj:IsA("ModuleScript")) then return obj end
        end
        local list = Explorer and Explorer.Selection and Explorer.Selection.List or {}
        for _, node in ipairs(list) do
            local obj = node and node.Obj
            if obj and (obj:IsA("LocalScript") or obj:IsA("ModuleScript")) then return obj end
        end
        return nil
    end

    local function showV5(title, body, meta)
        if type(Main.ShowViewer901) == "function" then
            return Main.ShowViewer901(title, tostring(body or ""), meta)
        end
        return false
    end

    local function closureReportV5(closure, owner)
        if type(closure) ~= "function" then
            return "No Lua closure was supplied."
        end
        local lines = {"TARGET", "  "..tostring(owner and owner.GetFullName and owner:GetFullName() or closure), ""}
        local getinfo = apiV5("getinfo")
        if getinfo then
            local ok, info = pcall(getinfo, closure)
            lines[#lines + 1] = "FUNCTION INFO"
            lines[#lines + 1] = ok and dumpV5(info) or ("ERROR: "..tostring(info))
            lines[#lines + 1] = ""
        end
        local groups = {
            {"CONSTANTS", "getconstants", "getconstant"},
            {"UPVALUES", "getupvalues", "getupvalue"},
            {"PROTOTYPES", "getprotos", "getproto"},
        }
        for _, group in ipairs(groups) do
            local title, allName, oneName = group[1], group[2], group[3]
            local enabled = true
            if title == "CONSTANTS" then enabled = Settings.ReverseEngineering.ShowConstants ~= false end
            if title == "UPVALUES" then enabled = Settings.ReverseEngineering.ShowUpvalues ~= false end
            if title == "PROTOTYPES" then enabled = Settings.ReverseEngineering.ShowPrototypes ~= false end
            if enabled then
                lines[#lines + 1] = title
                local allFn = apiV5(allName)
                if not allFn then
                    lines[#lines + 1] = "  unavailable"
                else
                    local okAll, allValue = pcall(allFn, closure)
                    if okAll and type(allValue) == "table" then
                        local indexes = {}
                        for k in pairs(allValue) do
                            if type(k) == "number" then indexes[#indexes + 1] = k end
                        end
                        table.sort(indexes)
                        local oneFn = apiV5(oneName)
                        for _, index in ipairs(indexes) do
                            local value = allValue[index]
                            if oneFn then
                                local okOne, oneValue = pcall(oneFn, closure, index)
                                if okOne then value = oneValue end
                            end
                            lines[#lines + 1] = "  ["..tostring(index).."] = "..dumpV5(value)
                        end
                    elseif okAll then
                        lines[#lines + 1] = "  "..dumpV5(allValue)
                    else
                        lines[#lines + 1] = "  ERROR: "..tostring(allValue)
                    end
                end
                lines[#lines + 1] = ""
            end
        end
        for _, name in ipairs({"islclosure", "iscclosure", "isnewcclosure", "isexecutorclosure", "isfunctionhooked"}) do
            local fn = apiV5(name)
            if fn then
                local ok, value = pcall(fn, closure)
                lines[#lines + 1] = name.." = "..(ok and tostring(value) or "ERROR: "..tostring(value))
            end
        end
        local dis = apiV5("disassemble")
        if dis and Settings.ReverseEngineering.ShowDisassembly then
            local ok, value = pcall(dis, closure, {Recursive=true, ShowLines=true, ShowConstants=true, StringPreviewMax=256})
            lines[#lines + 1] = ""
            lines[#lines + 1] = "DISASSEMBLY"
            lines[#lines + 1] = ok and tostring(value) or ("ERROR: "..tostring(value))
        end
        return table.concat(lines, "\n")
    end

