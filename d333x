	Main.CopyPropertiesAsync=function(nodes,includeChildren)
		local roots=nodes or {}
		if #roots==0 then return false,"No selection" end
		local statusWindow,statusHolder=Main.CreateToolWindow(includeChildren and "Copy All Properties + Children" or "Copy Properties",470,170)
		makeLabel(statusHolder,includeChildren and "Collecting selected objects and descendants" or "Collecting selected objects",14,14,438,24,15)
		local status=makeLabel(statusHolder,"Preparing...",14,46,438,42,12)
		task.spawn(function()
			local ordered={}
			local seen={}
			local depthMap={}
			local function addObject(obj,depth)
				if not obj or seen[obj] then return end
				seen[obj]=true
				depthMap[obj]=depth
				ordered[#ordered+1]={Obj=obj,Depth=depth}
			end
			for _,node in ipairs(roots) do
				local root=node and node.Obj
				if root then
					addObject(root,0)
					if includeChildren then
						local descendants=root:GetDescendants()
						for i,child in ipairs(descendants) do
							local parent=child.Parent
							local depth=depthMap[parent] and depthMap[parent]+1 or 1
							addObject(child,depth)
							if i%48==0 then task.wait() end
						end
					end
				end
				if #ordered%16==0 then task.wait() end
			end
			local chunks={}
			for index,item in ipairs(ordered) do
				local obj=item.Obj
				local indent=string.rep("    ",item.Depth or 0)
				chunks[#chunks+1]=indent.."Object: "..tostring(obj)
				chunks[#chunks+1]=indent.."Class: "..tostring(obj.ClassName)
				chunks[#chunks+1]=indent.."Path: "..objectPath(obj)
				local ok,text=pcall(function() return Properties.GetClipboardText({{Obj=obj}},false) end)
				if ok and type(text)=="string" then
					local body=text:gsub("^Object:.-\n","",1):gsub("^Class:.-\n","",1):gsub("^Path:.-\n","",1)
					chunks[#chunks+1]=body:gsub("\n","\n"..indent)
				else
					chunks[#chunks+1]=indent.."[Properties unavailable: "..tostring(text).."]"
				end
				if index%10==0 then status.Text="Processed "..tostring(index).." / "..tostring(#ordered) task.wait() end
			end
			local final=table.concat(chunks,"\n")
			local copied=copy(final)
			status.Text=(copied and "Copied " or "Built ")..tostring(#ordered).." object(s)"
		end)
		return true
	end
