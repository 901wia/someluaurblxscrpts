            return Settings.Explorer.AdvancedFilters.CaseSensitive and name==filter or string.lower(name)==string.lower(filter)
        end
        return (Settings.Explorer.AdvancedFilters.CaseSensitive and string.find(name,filter,1,true) or string.find(string.lower(name),string.lower(filter),1,true))~=nil
    end

