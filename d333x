		return string.format("%q",value)
	end

	Main.DecompileToWorkspace = function(objects)
		local scripts,seen={},{}
		for _,obj in ipairs(objects or {}) do
			if obj and not seen[obj] and (obj:IsA("LocalScript") or obj:IsA("ModuleScript")) then
				seen[obj]=true
				scripts[#scripts+1]=obj
			end
		end
		if #scripts==0 then return nil,"No LocalScript or ModuleScript selected" end
		if type(env.decompile)~="function" then return nil,"Decompile is unavailable" end
		if type(env.writefile)~="function" then return nil,"writefile is unavailable" end
		if type(env.makefolder)=="function" then pcall(env.makefolder,"dex") pcall(env.makefolder,"dex/decompiled") end
		local outputs={}
		for _,obj in ipairs(scripts) do
			local source,captureKey=captureSource(obj)
			if source and source~="" then outputs[#outputs+1]={Object=obj,Source=source,Key=captureKey} end
		end
		if #outputs==0 then return nil,"No usable decompiler output" end
		local stamp=tostring(os.time())
		if #outputs==1 then
			local obj=outputs[1].Object
			local safe=Main.SanitizeFileName(obj.Name)
			local path="dex/decompiled/"..safe.."_"..stamp..".luau"
			local ok,err=pcall(env.writefile,path,outputs[1].Source)
			if not ok then return nil,tostring(err) end
			return path,outputs
		end
		local header={"Decompiled Selection","PlaceId="..tostring(game.PlaceId),"GameId="..tostring(game.GameId),""}
		for i,item in ipairs(outputs) do
			header[#header+1]="===== "..tostring(i).." | "..item.Object.ClassName.." | "..item.Object:GetFullName().." ====="
			header[#header+1]=item.Source
			header[#header+1]=""
		end
		local path="dex/decompiled/Place_"..tostring(game.PlaceId).."_Selection_"..stamp..".luau"
		local ok,err=pcall(env.writefile,path,table.concat(header,"\n"))
		if not ok then return nil,tostring(err) end
		return path,outputs
	end

	Main.SaveInstanceToWorkspace = function(objects)
		if type(env.saveinstance)~="function" then return nil,"saveinstance is unavailable" end
		if type(env.makefolder)=="function" then pcall(env.makefolder,"dex") pcall(env.makefolder,"dex/saved") end
		local list=objects or {}
		if #list==0 then return nil,"No object selected" end
		local results={}
		local function localSafeName(value)
			local text=tostring(value or "Object")
			text=text:gsub("[^%w%._%- ]","_"):gsub("%s+","_")
			if text=="" then text="Object" end
			return text:sub(1,120)
		end
		for index,node in ipairs(list) do
			local obj=node and node.Obj or node
			if obj then
				local safe=localSafeName(obj.Name or obj.ClassName)
				local isDataModel=obj==game
				local extension=isDataModel and ".rbxlx" or ".rbxmx"
				local path="dex/saved/"..safe.."_"..tostring(os.time()).."_"..tostring(index)..extension
				local options={FilePath=path,Decompile=true,DecompileScripts=true,scriptcache=true,EmbedBytecode=true,IgnoreDefaultProperties=false,IgnoreSpecialProperties=false,IsModel=not isDataModel}
				local ok,result=pcall(env.saveinstance,obj,options)
				results[#results+1]={Object=obj,Path=ok and result or path,Ok=ok,Error=ok and nil or tostring(result)}
			end
		end
		return results
	end

