    local function patchContextMenu()
        local contextType = Lib.ContextMenu
        if not contextType or contextType._Modern901 then return end
        contextType._Modern901 = true
        local oldShow = contextType.Show
        if type(oldShow) == "function" then
            contextType.Show = function(self,x,y)
                local vpX,vpY = viewport()
                self.Width = math.min(tonumber(self.Width) or 250,math.max(220,vpX-12))
                self.MaxHeight = math.max(160,vpY-16)
                x = tonumber(x) or Main.Mouse.X
                y = tonumber(y) or Main.Mouse.Y
                x = math.max(6,math.min(x,vpX-(self.Width or 250)-6))
                y = math.max(6,math.min(y,vpY-6))
                return oldShow(self,x,y)
            end
        end
        local oldRefresh = contextType.Refresh
        if type(oldRefresh) == "function" then
            contextType.Refresh = function(self,...)
                local result = oldRefresh(self,...)
                local list = self.GuiElems and self.GuiElems.List
                if list then
                    for _,entry in ipairs(list:GetChildren()) do
                        if entry:IsA("TextButton") then
                            local name = entry:FindFirstChild("EntryName")
                            local shortcut = entry:FindFirstChild("Shortcut")
                            if name then
                                name.TextTruncate = Enum.TextTruncate.AtEnd
                                local hasShortcut = shortcut and shortcut.Text ~= ""
                                if self.Iconless then
                                    name.Position = UDim2.new(0,2,0,0)
                                    name.Size = UDim2.new(1,hasShortcut and -60 or -4,1,0)
                                else
                                    name.Position = UDim2.new(0,24,0,0)
                                    name.Size = UDim2.new(1,hasShortcut and -82 or -28,1,0)
                                end
                            end
                        end
                    end
                end
                return result
            end
        end
    end

