	Main.FireSignalWithInspector = function(obj,eventName,argsSource)
		if not obj or obj:IsA("LuaSourceContainer") or obj:IsA("RemoteFunction") then return false,"This object is not fireable through Fire Event" end
		local okSignal,signal=pcall(function() return obj[eventName] end)
		if not okSignal or not signal then return false,"Signal unavailable" end
		local args,err=Main.CompileArgs(argsSource or "")
		if not args then return false,"Argument parse error: "..tostring(err) end
		local className=tostring(obj.ClassName)
		if (className=="RemoteEvent" or className=="UnreliableRemoteEvent") and type(env.replicatesignal)=="function" then
			if type(env.cansignalreplicate)=="function" then
				local okAllowed,allowed=pcall(env.cansignalreplicate,signal)
				if okAllowed and not allowed then return false,"Signal replication rejected for this signal" end
			end
			local ok,errValue=pcall(env.replicatesignal,signal,unpack(args))
			return ok,(ok and "Remote event replicated successfully. Return value: none." or "Replication error: "..tostring(errValue))
		end
		if type(env.firesignal)~="function" then return false,"firesignal is unavailable" end
		local ok,errValue=pcall(env.firesignal,signal,unpack(args))
		return ok,(ok and "Local signal fired successfully. Return value: none." or "Fire error: "..tostring(errValue))
	end

