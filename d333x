				local index=0 for key,value in pairs(data) do index=index+1 if index<=80 then inspectable(panel,0,"Constant ["..tostring(key).."]",value) end end
			end
		end
		if type(env.getupvalues)=="function" then
			local ok,data=pcall(env.getupvalues,target)
