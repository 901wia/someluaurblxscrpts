		Main.TrackConnection(Lifecycle:Connect(cancel.MouseButton1Click, function() if window.Close then window:Close() end end))
		task.spawn(function()
			local ordered = {}
			local seen = {}
			local depthMap = {}
			local function addObject(object, depth)
				if not object or seen[object] then return end
				seen[object] = true
				depthMap[object] = depth
				ordered[#ordered + 1] = {Obj = object, Depth = depth}
			end
			for _, node in ipairs(roots) do
				local root = node and node.Obj
				if root then
					addObject(root, 0)
					if includeChildren then
						local descendants = root:GetDescendants()
						for index, child in ipairs(descendants) do
							local parent = child.Parent
							local depth = depthMap[parent] and depthMap[parent] + 1 or 1
							addObject(child, depth)
							if index % 64 == 0 then task.wait() end
						end
					end
				end
				task.wait()
			end
			local chunks = {}
			for index, item in ipairs(ordered) do
				local object = item.Obj
				local indent = string.rep("    ", item.Depth or 0)
				chunks[#chunks + 1] = indent .. "Object: " .. tostring(object)
				chunks[#chunks + 1] = indent .. "Class: " .. tostring(object.ClassName)
				chunks[#chunks + 1] = indent .. "Path: " .. hGetFullName(object)
				if Properties and type(Properties.GetClipboardText) == "function" then
					local ok, text = pcall(Properties.GetClipboardText, {{Obj = object}}, false)
					if ok and type(text) == "string" then
						local body = text:gsub("^Object:.-\n", "", 1):gsub("^Class:.-\n", "", 1):gsub("^Path:.-\n", "", 1)
						chunks[#chunks + 1] = body:gsub("\n", "\n" .. indent)
					else
						chunks[#chunks + 1] = indent .. "[Properties unavailable: " .. tostring(text) .. "]"
					end
				end
				if index % 4 == 0 then
					status.Text = "Processed " .. tostring(index) .. " / " .. tostring(#ordered)
					task.wait()
				end
			end
			local final = table.concat(chunks, "\n")
			local copied = hClipboard(final)
			status.Text = (copied and "Copied " or "Built ") .. tostring(#ordered) .. " object(s)"
		end)
		window:ShowAndFocus()
		return true
	end
