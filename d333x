                local blocker=nil
                local got=pcall(function() blocker=type(packet.Block)=="function" and packet.Block or (type(packet.Ignore)=="function" and packet.Ignore or nil) end)
                local blocked=false
                if got and type(blocker)=="function" then blocked=pcall(blocker,packet) end
                entry.state=blocked and "Blocked" or "Block unavailable/failed"
                if blocked then statsData.blocked += 1 end
            end
            local rewriteNumber=tonumber(rewriteId.Text)
            if rewriteRule and rewriteNumber and id==math.floor(rewriteNumber) then
