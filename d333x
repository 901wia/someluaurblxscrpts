		if not instance or typeof(instance) ~= "Instance" then return instance end

		if Main.DexProtectGuiState[instance] == nil then
			local originalArchivable
			pcall(function() originalArchivable = Reflection.ReadArchivable(instance) end)
			Main.DexProtectGuiState[instance] = originalArchivable
