	Main.CopyPropertiesAsync=function(nodes,includeChildren)
		local roots=nodes or {}
		if #roots==0 then return false,"No selection" end
		local statusWindow,statusHolder=Main.CreateToolWindow(includeChildren and "Copy Properties + Children" or "Copy Properties",480,180)
		makeText(statusHolder,"Preparing property export",14,14,450,24,15)
		local status=makeText(statusHolder,"Collecting objects without blocking the render step...",14,48,450,46,12)
		task.spawn(function()
			local collected={}
			local ordered={}
			local seen={}
			for _,node in ipairs(roots) do
				local root=node and node.Obj
				if root and not seen[root] then seen[root]=true ordered[#ordered+1]={Obj=root,Depth=0} end
				if includeChildren and root then
					local descendants=root:GetDescendants()
					for i,child in ipairs(descendants) do
						if not seen[child] then
							seen[child]=true
							local depth=0
							local current=child.Parent
							while current and current~=root do depth=depth+1 current=current.Parent end
							ordered[#ordered+1]={Obj=child,Depth=depth+1}
						end
						if i%32==0 then task.wait() end
					end
				end
			end
			for i,item in ipairs(ordered) do
				local obj=item.Obj
				local indent=string.rep("    ",item.Depth)
				collected[#collected+1]=indent.."Object: "..tostring(obj)
				collected[#collected+1]=indent.."Class: "..tostring(obj.ClassName)
				collected[#collected+1]=indent.."Path: "..tostring(Main.InstancePath(obj))
				local ok,text=pcall(function() return Properties.GetClipboardText({{Obj=obj}},false) end)
				if ok and type(text)=="string" then
					local body=text:gsub("^Object:.-\n","",1):gsub("^Class:.-\n","",1):gsub("^Path:.-\n","",1)
					collected[#collected+1]=body
				else
					collected[#collected+1]=indent.."[Properties unavailable: "..tostring(text).."]"
				end
				if i%12==0 then
					status.Text="Processed "..tostring(i).." / "..tostring(#ordered)
					task.wait()
				end
			end
			local final=table.concat(collected,"\n")
			clipboard(final)
			status.Text="Copied "..tostring(#ordered).." object(s)"
		end)
		return true
	end
