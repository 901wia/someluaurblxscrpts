do
    Settings = Settings or {}
    Settings.DexProtect = Settings.DexProtect or {Enabled = true}

    local function runtimeFunction(name)
        local getter = rawget(_G, "getgenv")
        if type(getter) == "function" then
            local ok, globalEnv = pcall(getter)
            if ok and type(globalEnv) == "table" then
                local value
                local readOk, readValue = pcall(rawget, globalEnv, name)
                if readOk then value = readValue end
                if type(value) == "function" then return value end
            end
        end
        local ok, value = pcall(rawget, _G, name)
        if ok and type(value) == "function" then return value end
        if type(env) == "table" and type(env[name]) == "function" then return env[name] end
        return nil
    end

    local function safeFullName(instance)
        local ok, value = pcall(function()
            return instance:GetFullName()
        end)
        if ok and type(value) == "string" and value ~= "" then return value end
        local nameOk, name = pcall(function() return instance.Name end)
        return nameOk and tostring(name) or "<unknown>"
    end

    local function isScriptTarget(instance)
        local ok, result = pcall(function()
            if typeof(instance) ~= "Instance" then return false end
            if instance:IsA("LocalScript") or instance:IsA("ModuleScript") or instance:IsA("CoreScript") then return true end
            if instance:IsA("Script") then
                local runContextOk, runContext = pcall(function() return instance.RunContext end)
                return runContextOk and runContext == Enum.RunContext.Client
            end
            return false
        end)
        return ok and result == true
    end

    local function safeCloneReference(instance)
        if typeof(instance) ~= "Instance" then return instance end
        local cloneRef = runtimeFunction("cloneref")
        if not cloneRef then cloneRef = runtimeFunction("clonereference") end
        if type(cloneRef) ~= "function" then return instance end
        local ok, reference = pcall(cloneRef, instance)
        if not ok or typeof(reference) ~= "Instance" then return instance end
        local compare = runtimeFunction("compareinstances")
        if type(compare) == "function" then
            local cmpOk, equal = pcall(compare, instance, reference)
            if not cmpOk or equal ~= true then return instance end
        end
        return reference
    end

    Main.DexProtectRefs = Main.DexProtectRefs or {}
    Main.DexProtectGuiState = Main.DexProtectGuiState or setmetatable({}, {__mode = "k"})

    local function protectInstance(instance, key)
        if typeof(instance) ~= "Instance" then return false end

        if Main.DexProtectGuiState[instance] == nil then
            local ok, original = pcall(function()
                return instance.Archivable
            end)
            Main.DexProtectGuiState[instance] = ok and original or nil
        end

        local protected = false
        local protectGui = runtimeFunction("protectgui")
        if type(protectGui) ~= "function" then protectGui = runtimeFunction("protect_gui") end
        if type(protectGui) == "function" then
            local ok = pcall(protectGui, instance)
            protected = protected or ok
        end

        pcall(function()
            if instance:IsA("ScreenGui") then
                instance.ResetOnSpawn = false
            end
        end)

        local setHidden = runtimeFunction("sethiddenproperty")
        if type(setHidden) == "function" then
            local ok = pcall(setHidden, instance, "Archivable", false)
            protected = protected or ok
        else
            local ok = pcall(function()
                instance.Archivable = false
            end)
            protected = protected or ok
        end

        if key then
            Main.DexProtectRefs[key] = safeCloneReference(instance)
        end
        return protected
    end

    local function restoreInstance(instance, original)
        if typeof(instance) ~= "Instance" or original == nil then return false end
        local setHidden = runtimeFunction("sethiddenproperty")
        if type(setHidden) == "function" then
            local ok = pcall(setHidden, instance, "Archivable", original)
            if ok then return true end
        end
        local ok = pcall(function()
            instance.Archivable = original
        end)
        return ok
    end

    local function unprotectManaged()
        for instance, original in pairs(Main.DexProtectGuiState or {}) do
            restoreInstance(instance, original)
        end
        table.clear(Main.DexProtectRefs)
    end

    local function applyProtection()
        if not Settings.DexProtect or Settings.DexProtect.Enabled == false then return end
        for index, gui in ipairs(Main.ManagedGuis or {}) do
            if gui then protectInstance(gui, "Gui_" .. tostring(index)) end
        end
        if Main.MainGui then protectInstance(Main.MainGui, "MainGui") end
        if Main.GuiHolder then protectInstance(Main.GuiHolder, "GuiHolder") end
        for index, window in ipairs(Main.UtilityWindows or {}) do
            local gui
            pcall(function() gui = window.Gui end)
            if gui then protectInstance(gui, "Window_" .. tostring(index)) end
        end
    end

    Main.ProtectDexInstance = function(instance, key)
        if not Settings.DexProtect or Settings.DexProtect.Enabled == false then return instance end
        protectInstance(instance, key)
        return instance
    end

    Main.SetDexProtect = function(enabled)
        Settings.DexProtect = Settings.DexProtect or {}
        local state = enabled ~= false
        Settings.DexProtect.Enabled = state
        if state then
            task.defer(applyProtection)
        else
            unprotectManaged()
        end
        return state
    end

    Main.TrackGui = function(gui)
        if gui and not table.find(Main.ManagedGuis, gui) then
            Main.ManagedGuis[#Main.ManagedGuis + 1] = gui
        end
        if gui and Settings.DexProtect and Settings.DexProtect.Enabled ~= false then
            protectInstance(gui, "Gui_" .. tostring(table.find(Main.ManagedGuis, gui) or #Main.ManagedGuis))
        end
        return gui
    end

    Main.ResolveRealAPI = function(name)
        return runtimeFunction(name)
    end

    Main.IsDecompilerTarget = function(instance)
        return isScriptTarget(instance)
    end

    Main.GetScriptBytecode = function(scriptObject)
        if not isScriptTarget(scriptObject) then return nil, "Script expected" end

        local getter = runtimeFunction("getscriptbytecode")
        local alias = runtimeFunction("dumpstring")
        local tried = {}
        local lastError

        for _, reader in ipairs({getter, alias}) do
            if type(reader) == "function" and not tried[reader] then
                tried[reader] = true
                local ok, value = pcall(reader, scriptObject)
                if ok and type(value) == "string" and #value > 8 then
                    return value, nil
                end
                if not ok then lastError = tostring(value) end
            end
        end

        return nil, lastError or "bytecode unavailable"
    end

    Main.DecompileScript = function(scriptObject)
        if not isScriptTarget(scriptObject) then
            return nil, "Script expected"
        end

        local decompiler = runtimeFunction("decompile")
        if decompiler == Main.DecompileScript then decompiler = nil end

        if type(decompiler) == "function" then
            local ok, value = pcall(decompiler, scriptObject)
            if ok and type(value) == "string" and value ~= "" then
                return value, nil
            end
            if not ok then
                local message = tostring(value)
                if message ~= "" then
                    local sourceOk, source = pcall(function() return scriptObject.Source end)
                    if sourceOk and type(source) == "string" and source ~= "" then
                        return source, nil
                    end
                    return nil, message
                end
            end
        end

        local sourceOk, source = pcall(function()
            return scriptObject.Source
        end)
        if sourceOk and type(source) == "string" and source ~= "" then
            return source, nil
        end

        return nil, "decompile unavailable"
    end

    Main.GetScriptClosure = function(scriptObject)
        if not isScriptTarget(scriptObject) then return nil, "Script expected" end
        local getter = runtimeFunction("getscriptclosure")
        if type(getter) ~= "function" then return nil, "getscriptclosure unavailable" end
        local ok, closure = pcall(getter, scriptObject)
        if ok and type(closure) == "function" then return closure, nil end
        return nil, ok and "closure unavailable" or tostring(closure)
    end

    Main.DecompileOrDisassemble = function(scriptObject)
        local source, sourceError = Main.DecompileScript(scriptObject)
        if source then return source, "decompile", nil end

        local closure, closureError = Main.GetScriptClosure(scriptObject)
        local disassembler = runtimeFunction("disassemble")
        if closure and type(disassembler) == "function" then
            local ok, output = pcall(disassembler, closure, {
                Recursive = true,
                ShowLines = true,
                ShowConstants = true,
                StringPreviewMax = 256
            })
            if ok and type(output) == "string" and output ~= "" then
                return output, "disassemble", sourceError
            end
            return nil, nil, tostring(output)
        end

        return nil, nil, sourceError or closureError or "No usable decompiler or disassembler"
    end

    Main.BuildSecureDecompileReport = function(scriptObject)
        if not isScriptTarget(scriptObject) then
            return nil, "Script expected"
        end

        local sections = {}
        local function add(name, value)
            sections[#sections + 1] = {
                Name = name,
                Text = tostring(value or "")
            }
        end

        local nameOk, name = pcall(function() return scriptObject.Name end)
        local classOk, className = pcall(function() return scriptObject.ClassName end)
        local source, sourceError = Main.DecompileScript(scriptObject)
        local bytecode, bytecodeError = Main.GetScriptBytecode(scriptObject)
        local closure, closureError = Main.GetScriptClosure(scriptObject)

        add("Target", table.concat({
            "Name = " .. tostring(nameOk and name or safeFullName(scriptObject)),
            "Class = " .. tostring(classOk and className or "?"),
            "Path = " .. safeFullName(scriptObject),
            "PlaceId = " .. tostring(game.PlaceId),
            "GameId = " .. tostring(game.GameId),
            "JobId = " .. tostring(game.JobId)
        }, "\n"))

        add("Decompiled Source", source or "Unavailable: " .. tostring(sourceError))

        if bytecode then
            local encode = runtimeFunction("base64_encode")
            local encoded
            if type(encode) == "function" then
                local ok, value = pcall(encode, bytecode)
                if ok and type(value) == "string" then encoded = value end
            end
            if encoded then
                add("Raw Bytecode", tostring(#bytecode) .. " bytes\n" .. encoded)
            else
                local hex = {}
                for i = 1, math.min(#bytecode, 4096) do
                    hex[#hex + 1] = string.format("%02X", string.byte(bytecode, i))
                end
                add("Raw Bytecode", tostring(#bytecode) .. " bytes\nHEX\n" .. table.concat(hex, " "))
            end
        else
            add("Raw Bytecode", "Unavailable: " .. tostring(bytecodeError))
        end

        local scriptHash = runtimeFunction("getscripthash")
        if type(scriptHash) == "function" then
            local ok, value = pcall(scriptHash, scriptObject)
            add("Script Hash", ok and tostring(value) or "ERROR: " .. tostring(value))
        end

        add("Closure", closure and tostring(closure) or "Unavailable: " .. tostring(closureError))

        if closure then
            local functionHash = runtimeFunction("getfunctionhash")
            if type(functionHash) == "function" then
                local ok, value = pcall(functionHash, closure)
                add("Function Hash", ok and tostring(value) or "ERROR: " .. tostring(value))
            end

            local getInfo = runtimeFunction("getinfo")
            if type(getInfo) == "function" then
                local ok, value = pcall(getInfo, closure)
                add("Function Info", ok and Main.FormatInspectValue(value) or "ERROR: " .. tostring(value))
            end

            local getConstants = runtimeFunction("getconstants")
            local getConstant = runtimeFunction("getconstant")
            if type(getConstants) == "function" or type(getConstant) == "function" then
                local lines = {}
                local seen = {}

                if type(getConstants) == "function" then
                    local ok, values = pcall(getConstants, closure)
                    if ok and type(values) == "table" then
                        for index, value in pairs(values) do
                            if type(index) == "number" and index >= 1 and index <= 600 then
                                seen[index] = true
                                lines[#lines + 1] = "Constant[" .. tostring(index) .. "] = " .. Main.FormatInspectValue(value)
                            end
                        end
                    end
                end

                if type(getConstant) == "function" then
                    for index = 1, 600 do
                        if not seen[index] then
                            local ok, value = pcall(getConstant, closure, index)
                            if ok and value ~= nil then
                                seen[index] = true
                                lines[#lines + 1] = "Constant[" .. tostring(index) .. "] = " .. Main.FormatInspectValue(value)
                            end
                        end
                    end
                end

                table.sort(lines)
                add("Constants", #lines > 0 and table.concat(lines, "\n") or "{}")
            end

            local getUpvalues = runtimeFunction("getupvalues")
            local getUpvalue = runtimeFunction("getupvalue")
            if type(getUpvalues) == "function" or type(getUpvalue) == "function" then
                local lines = {}
                local seen = {}

                if type(getUpvalues) == "function" then
                    local ok, values = pcall(getUpvalues, closure)
                    if ok and type(values) == "table" then
                        for index, value in pairs(values) do
                            if type(index) == "number" and index >= 1 and index <= 600 then
                                seen[index] = true
                                lines[#lines + 1] = "Upvalue[" .. tostring(index) .. "] = " .. Main.FormatInspectValue(value)
                            end
                        end
                    end
                end

                if type(getUpvalue) == "function" then
                    for index = 1, 600 do
                        if not seen[index] then
                            local ok, value = pcall(getUpvalue, closure, index)
                            if ok and value ~= nil then
                                seen[index] = true
                                lines[#lines + 1] = "Upvalue[" .. tostring(index) .. "] = " .. Main.FormatInspectValue(value)
                            end
                        end
                    end
                end

                table.sort(lines)
                add("Upvalues", #lines > 0 and table.concat(lines, "\n") or "{}")
            end

            local getProtos = runtimeFunction("getprotos")
            local getProto = runtimeFunction("getproto")
            if type(getProtos) == "function" then
                local ok, protos = pcall(getProtos, closure)
                if ok and type(protos) == "table" then
                    local lines = {}
                    for index, proto in ipairs(protos) do
                        if index > 600 then break end
                        local line = "Proto[" .. tostring(index) .. "] = " .. tostring(proto)
                        if type(getProto) == "function" then
                            local protoOk, protoValue = pcall(getProto, closure, index)
                            if protoOk and protoValue then
                                line = line .. " | getproto = " .. tostring(protoValue)
                            end
                        end
                        local getInfo = runtimeFunction("getinfo")
                        if type(getInfo) == "function" then
                            local infoOk, info = pcall(getInfo, proto)
                            if infoOk and type(info) == "table" then
                                line = line .. " | " .. tostring(info.name or "anonymous") .. " @ " .. tostring(info.currentline or "?")
                            end
                        end
                        lines[#lines + 1] = line
                    end
                    add("Nested Prototypes", #lines > 0 and table.concat(lines, "\n") or "{}")
                else
                    add("Nested Prototypes", "getprotos unavailable or failed")
                end
            end

            local disassembler = runtimeFunction("disassemble")
            if type(disassembler) == "function" then
                local ok, output = pcall(disassembler, closure, {
                    Recursive = true,
                    ShowLines = true,
                    ShowConstants = true,
                    StringPreviewMax = 256
                })
                add("Disassembler", ok and tostring(output) or "ERROR: " .. tostring(output))
            end
        end

        return sections, source, bytecode
    end

    Main.FormatSecureDecompileReport = function(scriptObject)
        local sections, sourceOrError, bytecode = Main.BuildSecureDecompileReport(scriptObject)
        if not sections then return nil, sourceOrError end
        local output = {"Secure Decompile Report", ""}
        for _, section in ipairs(sections) do
            output[#output + 1] = "===== " .. section.Name .. " ====="
            output[#output + 1] = section.Text
            output[#output + 1] = ""
        end
        return table.concat(output, "\n"), sourceOrError, bytecode
    end

    if Explorer and type(Explorer.DecompileSelected) == "function" then
        Explorer.DecompileSelected = function()
            local selected = {}
            if Explorer.Selection and Explorer.Selection.List then
                for _, node in ipairs(Explorer.Selection.List) do
                    local instance = node and node.Obj
                    if isScriptTarget(instance) then
                        selected[#selected + 1] = instance
                    end
                end
            end

            if #selected == 0 then
                return nil, "No supported script selected"
            end

            local writer = runtimeFunction("writefile")
            local mkdir = runtimeFunction("makefolder")
            if type(writer) ~= "function" then return nil, "writefile unavailable" end

            if type(mkdir) == "function" then
                pcall(mkdir, "dex")
                pcall(mkdir, "dex/decompiled")
            end

            local outputs = {}
            local errors = {}

            for _, scriptObject in ipairs(selected) do
                local source, sourceError = Main.DecompileScript(scriptObject)
                if source then
                    outputs[#outputs + 1] = "===== " .. safeFullName(scriptObject) .. " =====\n" .. source
                else
                    local disassembly, mode, fallbackError = Main.DecompileOrDisassemble(scriptObject)
                    if disassembly then
                        outputs[#outputs + 1] = "===== " .. safeFullName(scriptObject) .. " [" .. tostring(mode) .. "] =====\n" .. disassembly
                    else
                        errors[#errors + 1] = safeFullName(scriptObject) .. " => " .. tostring(fallbackError or sourceError or "unavailable")
                    end
                end
            end

            if #outputs == 0 then
                return nil, table.concat(errors, "\n")
            end

            local fileName = (#selected == 1 and tostring(selected[1].Name) or "Selection")
                :gsub("[^%w%._%- ]", "_")
            local path = "dex/decompiled/" .. fileName .. "_" .. tostring(os.time()) .. ".luau"
            local payload = table.concat(outputs, "\n\n")

            local ok, errorMessage = pcall(writer, path, payload)
            if not ok then return nil, tostring(errorMessage) end
            return path, payload, #errors > 0 and table.concat(errors, "\n") or nil
        end
    end

    if ScriptViewer and type(ScriptViewer.ViewScript) == "function" then
        ScriptViewer.ViewScript = function(scriptObject)
            if not isScriptTarget(scriptObject) then return nil, "Script expected" end
            local source, sourceError = Main.DecompileScript(scriptObject)
            if not source then source = "Decompilation unavailable: " .. tostring(sourceError) end
            local cache = Main.SourceCache or {}
            Main.SourceCache = cache
            local hashReader = runtimeFunction("getscripthash")
            local key = safeFullName(scriptObject)
            if type(hashReader) == "function" then
                local ok, hash = pcall(hashReader, scriptObject)
                if ok and hash then key = key .. "|" .. tostring(hash) end
            end
            cache[key] = source
            ScriptViewer.CurrentScript = scriptObject
            if ScriptViewer.CodeFrame and type(ScriptViewer.CodeFrame.SetText) == "function" then
                ScriptViewer.CodeFrame:SetText(source)
            elseif ScriptViewer.CodeFrame then
                ScriptViewer.CodeFrame.Text = source
            end
            if ScriptViewer.Window and type(ScriptViewer.Window.Show) == "function" then
                ScriptViewer.Window:Show()
            end
            return source
        end
    end

    task.defer(applyProtection)
end
