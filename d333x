			addSection(right,"Nested Prototypes",table.concat(lines,"\n"))
			if ok and type(data)=="table" then local panel=Instance.new("Frame") panel.BackgroundColor3=Settings.Theme.Main2 panel.BorderSizePixel=0 panel.Size=UDim2.new(1,-8,0,0) panel.AutomaticSize=Enum.AutomaticSize.Y panel.Parent=right local layout=Instance.new("UIListLayout") layout.Padding=UDim.new(0,3) layout.Parent=panel for index,proto in ipairs(data) do if index>80 then break end inspectable(panel,0,"Proto ["..tostring(index).."]",proto) end end
		end
		if type(env.getreg)=="function" then local ok,value=pcall(env.getreg) addSection(right,"Registry",ok and dump(value) or "ERROR: "..tostring(value)) end
		if type(env.getgc)=="function" then local ok,value=pcall(env.getgc,false) if ok and type(value)=="table" then local found=false for i=1,#value do if value[i]==target then found=true break end end addSection(right,"GC Presence",found and "Closure is present in getgc(false)" or "Closure not found in getgc(false)") end end
		if type(env.getstack)=="function" then
