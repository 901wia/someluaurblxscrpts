				win:Add(typeLabel)
				local typeChooser = Lib.DropDown.new()
				typeChooser.CanBeEmpty = false
				typeChooser.Position = UDim2.new(0,72,0,40)
				typeChooser.Size = UDim2.new(1,-92,0,20)
				typeChooser:SetOptions(Properties.AllowedAttributeTypes)
				win:Add(typeChooser,"TypeChooser")
				local errorLabel = Lib.Label.new()
				errorLabel.Text = ""
				errorLabel.Position = UDim2.new(0,10,1,-54)
				errorLabel.Size = UDim2.new(1,-20,0,24)
				errorLabel.TextColor3 = Settings.Theme.Important
				win:Add(errorLabel,"Error")
				local cancelButton = Lib.Button.new()
				cancelButton.Text = "Cancel"
				cancelButton.Position = UDim2.new(1,-105,1,-25)
				cancelButton.Size = UDim2.new(0,100,0,20)
				Lifecycle:Connect(cancelButton.OnClick, function() win:Close() end)
				win:Add(cancelButton)
				saveButton.Text = "Save"
				saveButton.Position = UDim2.new(0,5,1,-25)
				saveButton.Size = UDim2.new(0,95,0,20)
				Lifecycle:Connect(saveButton.OnClick, function()
					local name = trim(nameBox:GetText())
					if name == "" then errorLabel.Text = "Error: Name required" return end
					if #name > 100 then errorLabel.Text = "Error: Name over 100 chars" return end
					if name:sub(1,3):upper() == "RBX" then errorLabel.Text = "Error: Name begins with 'RBX'" return end
					local typ = typeChooser.Selected
					if not typ or typ == "" then errorLabel.Text = "Error: Choose a type" return end
					local valueType = Properties.TypeNameConvert[typ] or typ
					local defaultValue = Properties.DefaultPropValue[valueType]
					if defaultValue == nil then errorLabel.Text = "Error: Unsupported attribute type" return end

					local list = Explorer.Selection and Explorer.Selection.List or {}
					if #list == 0 then errorLabel.Text = "Error: No instances selected" return end

					local oldAttr = Properties.EditingAttribute
					local oldName = oldAttr and tostring(oldAttr.AttributeName) or nil
					local oldTypeName = oldAttr and oldAttr.ValueType and tostring(oldAttr.ValueType.Name) or nil
					local successCount, failureMessage = 0, nil

					for _,node in ipairs(list) do
						local obj = node and node.Obj
						if obj then
							local ok, err = pcall(function()
								local valueForObject = defaultValue
								local existing = getAttribute(obj,name)
								if existing ~= nil and oldName ~= name then
									error("An attribute named '"..name.."' already exists")
								end

								if oldName and oldName ~= name then
									if oldTypeName == valueType then
										local previousValue = getAttribute(obj,oldName)
										if previousValue ~= nil then valueForObject = previousValue end
									end
									setAttribute(obj,name,valueForObject)
									setAttribute(obj,oldName,nil)
								else
									setAttribute(obj,name,valueForObject)
								end

								local written = getAttribute(obj,name)
								if written == nil then
									error("Roblox rejected the attribute write")
								end
							end)
							if ok then
								successCount = successCount + 1
							else
								failureMessage = tostring(err)
							end
						end
					end

					if successCount == 0 then
						errorLabel.Text = "Error: "..tostring(failureMessage or "Attribute could not be created")
						return
					end
					if successCount < #list then
						errorLabel.Text = "Warning: Applied to "..tostring(successCount).."/"..tostring(#list).." instances"
						Properties.ShowExplorerProps()
						return
					end

					Settings.Properties.ShowAttributes = true
					Properties.EditingAttribute = nil
					Properties.ShowExplorerProps()
					win:Close()
				end)
				win:Add(saveButton,"SaveButton")
				Properties.AddAttributeWindow = win
				end
				Properties.EditingAttribute = editAttr
				win:SetTitle(editAttr and "Rename / Edit Attribute" or "Add Attribute")
				win.Elements.Error.Text = ""
				win.Elements.NameBox:SetText(editAttr and tostring(editAttr.AttributeName) or "")
				local selectedIndex = 1
				if editAttr then
					local wanted = editAttr.ValueType and editAttr.ValueType.Name
					for index,typeName in ipairs(Properties.AllowedAttributeTypes) do
						if (Properties.TypeNameConvert[typeName] or typeName) == wanted then selectedIndex=index break end
					end
				end
				win.Elements.TypeChooser:SetSelected(selectedIndex)
				if win.Elements.SaveButton and type(win.Elements.SaveButton.SetDisabled) == "function" then pcall(win.Elements.SaveButton.SetDisabled,win.Elements.SaveButton,editAttr == nil and #win.Elements.NameBox:GetText() == 0) end
				win:Show()
			end

