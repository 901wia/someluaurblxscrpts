			pcall(env.makefolder, "dex/decompiled")
			pcall(env.makefolder, "dex/inspectors")
			pcall(env.makefolder, "dex/disassembly")
			pcall(env.makefolder, "dex/snapshots")
			pcall(env.makefolder, Main.AssetFolder901)
		end
		if type(env.writefile) ~= "function" then return false, "writefile unavailable" end
		local ok, err = pcall(env.writefile, path, text)
		if not ok then return false, tostring(err) end
		return true, path
	end
	local function hRead(path)
		if type(env.readfile) ~= "function" then return nil end
		local ok, value = pcall(env.readfile, path)
		return ok and value or nil
	end
	local function hApi(name, ...)
		local fn = env and env[name]
		if type(fn) ~= "function" then return false, nil, name .. " unavailable" end
		local ok, a, b, c, d, e, f, g, h = pcall(fn, ...)
		if not ok then return false, nil, tostring(a) end
		return true, {a, b, c, d, e, f, g, h}, nil
	end
	local function hApiOne(name, ...)
		local ok, values, err = hApi(name, ...)
		if not ok then return false, nil, err end
		return true, values and values[1], nil
	end
	local function hValue(value, depth, seen)
		if type(Main.FormatInspectValue) == "function" then
			local ok, text = pcall(Main.FormatInspectValue, value, depth or 0, seen or {})
			if ok then return tostring(text) end
		end
		local valueType = type(value)
		if value == nil then return "nil" end
		if valueType == "string" then return string.format("%q", value) end
		return tostring(value)
	end
	local function hGetFullName(object)
		local ok, value = pcall(function() return object:GetFullName() end)
		return ok and tostring(value) or tostring(object)
	end
	local function hGetTargetList()
		local list = {}
		local seen = {}
		if Explorer and Explorer.Selection and Explorer.Selection.List then
			for _, node in ipairs(Explorer.Selection.List) do
				local object = node and node.Obj
				if object and not seen[object] then
					seen[object] = true
					list[#list + 1] = object
				end
			end
		end
		return list
	end
	local function hIsScript(object)
		if typeof(object) ~= "Instance" then return false end
		local ok, result = pcall(function()
			return object:IsA("LocalScript") or object:IsA("ModuleScript")
		end)
		return ok and result or false
	end
	local function hGetBytecode(scriptObject)
		local readers = {"getscriptbytecode", "dumpstring"}
		for _, name in ipairs(readers) do
			local ok, value = hApiOne(name, scriptObject)
			if ok and type(value) == "string" and #value > 0 then
				return value, name
			end
		end
		return nil, "unavailable"
	end
	local function hGetSource(scriptObject)
		local ok, value, err = hApiOne("decompile", scriptObject)
		if ok and type(value) == "string" and value ~= "" then return value end
		return nil, err or "decompile unavailable"
	end
	local function hSortedNumericKeys(value, limit)
		local keys = {}
		if type(value) ~= "table" then return keys end
		for key in pairs(value) do
			if type(key) == "number" then keys[#keys + 1] = key end
		end
		table.sort(keys)
		local max = limit or 600
		if #keys > max then
			for index = #keys, max + 1, -1 do keys[index] = nil end
		end
		return keys
	end
	local function hAccessorLines(target, allName, oneName, label)
		local out = {}
		local allOk, allValue, allErr = hApiOne(allName, target)
		local seen = {}
		if allOk and type(allValue) == "table" then
			for _, index in ipairs(hSortedNumericKeys(allValue, 600)) do
				seen[index] = true
				local value = allValue[index]
				local oneOk, oneValue = hApiOne(oneName, target, index)
				if oneOk then value = oneValue end
				out[#out + 1] = label .. "[" .. tostring(index) .. "] = " .. hValue(value, 0, {})
			end
		elseif not allOk then
			out[#out + 1] = label .. " API error = " .. tostring(allErr)
		end
		for index = 1, 600 do
			if not seen[index] then
				local oneOk, oneValue = hApiOne(oneName, target, index)
				if oneOk and oneValue ~= nil then
					seen[index] = true
					out[#out + 1] = label .. "[" .. tostring(index) .. "] = " .. hValue(oneValue, 0, {})
				end
			end
			if #out >= 600 then break end
		end
		if #out == 0 then out[1] = label .. " = {}" end
		return table.concat(out, "\n")
	end
	local function hProtoLines(closure)
		local out = {}
		local ok, values, err = hApi("getprotos", closure)
		if not ok then return "getprotos error = " .. tostring(err) end
		local protos = values and values[1]
		if type(protos) ~= "table" then return "getprotos returned " .. tostring(protos) end
		for _, index in ipairs(hSortedNumericKeys(protos, 600)) do
			local proto = protos[index]
			local line = "Proto[" .. tostring(index) .. "] = " .. tostring(proto)
			local getOneOk, getOneValue = hApiOne("getproto", closure, index)
			if getOneOk then line = line .. " | getproto = " .. tostring(getOneValue) end
			if type(proto) == "function" then
				local infoOk, info = hApiOne("getinfo", proto)
				if infoOk and type(info) == "table" then
					line = line .. " | name=" .. tostring(info.name or "anonymous") .. " | line=" .. tostring(info.currentline or "?")
				end
			end
			out[#out + 1] = line
		end
		if #out == 0 then return "getprotos = {}" end
		return table.concat(out, "\n")
	end
	local function hCapabilities(closure)
		local names = {"islclosure", "iscclosure", "isnewcclosure", "isexecutorclosure", "isfunctionhooked", "ishiddenstack"}
		local out = {}
		for _, name in ipairs(names) do
			local ok, value, err = hApiOne(name, closure)
			out[#out + 1] = name .. " = " .. (ok and tostring(value) or "ERROR: " .. tostring(err))
		end
		return table.concat(out, "\n")
	end
	local function hRuntimeSummary(scriptObject, closure)
		local out = {}
		local okThread, thread, errThread = hApiOne("getscriptthread", scriptObject)
		if okThread and type(thread) == "thread" then
			out[#out + 1] = "thread = " .. tostring(thread)
			local okIdentity, identity = hApiOne("getthreadidentity", thread)
			if okIdentity then out[#out + 1] = "identity = " .. tostring(identity) end
			local okOur, our = hApiOne("isourthread", thread)
			if okOur then out[#out + 1] = "isourthread = " .. tostring(our) end
			if Settings.Explorer.DeepRuntimeInspection then
				local okEnv, threadEnv = hApiOne("gettenv", thread)
				if okEnv then out[#out + 1] = "thread environment = " .. hValue(threadEnv, 0, {}) end
			end
		elseif errThread then
			out[#out + 1] = "getscriptthread = " .. tostring(errThread)
		end
		if closure and Settings.Explorer.DeepRuntimeInspection then
			local okStack, stack = hApiOne("getstack", 1)
			if okStack then out[#out + 1] = "stack[1] = " .. hValue(stack, 0, {}) end
		end
		return #out > 0 and table.concat(out, "\n") or "Runtime thread information unavailable"
	end
	Main.BuildDetailedDecompile = function(scriptObject)
		if not hIsScript(scriptObject) then return nil, "DetailedDecompile requires LocalScript or ModuleScript" end
		local sections = {}
		local function add(name, text)
			sections[#sections + 1] = {Name = name, Text = tostring(text or "")}
		end
		local path = hGetFullName(scriptObject)
		add("Target", table.concat({
			"Name = " .. tostring(scriptObject.Name),
			"Class = " .. tostring(scriptObject.ClassName),
			"Path = " .. path,
			"PlaceId = " .. tostring(game.PlaceId),
			"GameId = " .. tostring(game.GameId),
			"JobId = " .. tostring(game.JobId)
		}, "\n"))
		local source, sourceError = hGetSource(scriptObject)
		add("Decompiled Source", source or "Unavailable: " .. tostring(sourceError))
		local bytecode, bytecodeSource = hGetBytecode(scriptObject)
		if bytecode then
			local encoded
			local okBase64, base64Value = hApiOne("base64_encode", bytecode)
			if okBase64 and type(base64Value) == "string" then encoded = base64Value end
			add("Raw Bytecode", "Reader = " .. tostring(bytecodeSource) .. "\nLength = " .. tostring(#bytecode) .. " bytes\nBase64 = " .. tostring(encoded or "unavailable"))
		else
			add("Raw Bytecode", "Unavailable")
		end
		local hashOk, scriptHash, hashErr = hApiOne("getscripthash", scriptObject)
		add("Script Hash", hashOk and tostring(scriptHash) or "Unavailable: " .. tostring(hashErr))
		local closureOk, closure, closureErr = hApiOne("getscriptclosure", scriptObject)
		if not closureOk or type(closure) ~= "function" then
			add("Closure", "Unavailable: " .. tostring(closureErr))
		else
			add("Closure", tostring(closure))
			local fnHashOk, fnHash, fnHashErr = hApiOne("getfunctionhash", closure)
			add("Function Hash", fnHashOk and tostring(fnHash) or "Unavailable: " .. tostring(fnHashErr))
			local infoOk, info, infoErr = hApiOne("getinfo", closure)
			add("Function Info", infoOk and hValue(info, 0, {}) or "Unavailable: " .. tostring(infoErr))
			add("Constants + getconstant", hAccessorLines(closure, "getconstants", "getconstant", "Constant"))
			add("Upvalues + getupvalue", hAccessorLines(closure, "getupvalues", "getupvalue", "Upvalue"))
			add("Nested Prototypes + getproto", hProtoLines(closure))
			local disassembleOk, disassembly, disassembleErr = hApiOne("disassemble", closure, {Recursive = true, ShowLines = true, ShowConstants = true, StringPreviewMax = 256})
			add("Disassembler", disassembleOk and tostring(disassembly) or "Unavailable: " .. tostring(disassembleErr))
			add("Closure Capabilities", hCapabilities(closure))
		end
		add("Script Thread", hRuntimeSummary(scriptObject, closure))
		local envOk, scriptEnv, envErr = hApiOne("getsenv", scriptObject)
		add("Script Environment", envOk and hValue(scriptEnv, 0, {}) or "Unavailable: " .. tostring(envErr))
		if scriptObject:IsA("ModuleScript") then
			local moduleOk, moduleEnv, moduleErr = hApiOne("getmenv", scriptObject)
			add("Module Environment", moduleOk and hValue(moduleEnv, 0, {}) or "Unavailable: " .. tostring(moduleErr))
		end
		if Settings.Explorer.DeepRuntimeInspection then
			local gcOk, gcValue, gcErr = hApiOne("getgc", false)
			if gcOk and type(gcValue) == "table" then
				local found = false
				if closure then
					for i = 1, math.min(#gcValue, 100000) do
						if gcValue[i] == closure then found = true break end
					end
				end
				add("GC Summary", "Visible objects = " .. tostring(#gcValue) .. "\nClosure present = " .. tostring(found))
			else
				add("GC Summary", "Unavailable: " .. tostring(gcErr))
			end
			local regOk, registry, regErr = hApiOne("getreg")
			add("Registry Summary", regOk and hValue(registry, 0, {}) or "Unavailable: " .. tostring(regErr))
		end
		if not source and closure then
			local disassemblyOk, disassembly, disassemblyErr = hApiOne("disassemble", closure, {Recursive = true, ShowLines = true, ShowConstants = true, StringPreviewMax = 256})
			add("Decompiler Fallback", disassemblyOk and tostring(disassembly) or "Unable to disassemble: " .. tostring(disassemblyErr))
		end
		return sections, source, bytecode
	end
	Main.FormatDetailedDecompile = function(scriptObject)
		local sections, source, bytecode = Main.BuildDetailedDecompile(scriptObject)
		if not sections then return nil, source end
		local out = {"DetailedDecompile", ""}
		for _, sectionData in ipairs(sections) do
			out[#out + 1] = "===== " .. sectionData.Name .. " ====="
			out[#out + 1] = sectionData.Text
			out[#out + 1] = ""
		end
		return table.concat(out, "\n"), source, bytecode
	end
	Main.DecompileToWorkspace = function(objects)
		local scripts = {}
		local seen = {}
		for _, object in ipairs(objects or {}) do
			if object and not seen[object] and hIsScript(object) then
				seen[object] = true
				scripts[#scripts + 1] = object
			end
		end
		if #scripts == 0 then return nil, "No LocalScript or ModuleScript selected" end
		local outputs = {}
		local failures = {}
		for index, scriptObject in ipairs(scripts) do
			local source, err = hGetSource(scriptObject)
			if source then
				outputs[#outputs + 1] = {Object = scriptObject, Source = source}
			else
				failures[#failures + 1] = hGetFullName(scriptObject) .. " => " .. tostring(err)
			end
			if index % 2 == 0 then task.wait() end
		end
		if #outputs == 0 then
			local fallback = {"Normal Decompile Fallback", ""}
			for _, scriptData in ipairs(scripts) do
				local closureOk, closure = hApiOne("getscriptclosure", scriptData)
				fallback[#fallback + 1] = "===== " .. hGetFullName(scriptData) .. " ====="
				if closureOk and type(closure) == "function" then
					local disassembleOk, disassembly, disassembleErr = hApiOne("disassemble", closure, {Recursive = true, ShowLines = true, ShowConstants = true, StringPreviewMax = 256})
					fallback[#fallback + 1] = disassembleOk and tostring(disassembly) or "Disassembler failed: " .. tostring(disassembleErr)
				else
					local bytes = hGetBytecode(scriptData)
					fallback[#fallback + 1] = "Decompile unavailable: " .. tostring(failures[1] or "unknown")
					fallback[#fallback + 1] = "Bytecode length = " .. tostring(bytes and #bytes or 0)
				end
				fallback[#fallback + 1] = ""
			end
			local path = "dex/decompiled/" .. hSafeName(#scripts == 1 and scripts[1].Name or "Selection") .. "_DisassemblyFallback_" .. tostring(os.time()) .. ".txt"
			local ok, err = hWrite(path, table.concat(fallback, "\n"))
			if not ok then return nil, err end
			return path, table.concat(fallback, "\n")
		end
		local path
		if #scripts == 1 then
			path = "dex/decompiled/" .. hSafeName(scripts[1].Name) .. "_" .. tostring(os.time()) .. ".luau"
		else
			path = "dex/decompiled/Selection_" .. tostring(os.time()) .. ".txt"
		end
		local chunks = {}
		for _, item in ipairs(outputs) do
			if #outputs == 1 then
				chunks[#chunks + 1] = item.Source
			else
				chunks[#chunks + 1] = "===== " .. item.Object.ClassName .. " | " .. hGetFullName(item.Object) .. " =====\n" .. item.Source
			end
		end
		local payload = table.concat(chunks, "\n\n")
		local ok, err = hWrite(path, payload)
		if not ok then return nil, err end
		return path, payload
	end
	Main.DetailedDecompile = function(objects)
		local scripts = {}
		local seen = {}
		for _, object in ipairs(objects or {}) do
			if object and not seen[object] and hIsScript(object) then
				seen[object] = true
				scripts[#scripts + 1] = object
			end
		end
		if #scripts == 0 then return nil, "No LocalScript or ModuleScript selected" end
		local chunks = {}
		for index, scriptObject in ipairs(scripts) do
