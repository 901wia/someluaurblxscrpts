        local function parseLive(text,oldValue)
            local raw = trim(text)
            if raw == "nil" then return true,nil end
            local oldType = typeof(oldValue)
            if oldType == "string" then return true,raw end
            if oldType == "boolean" then
                local lower = string.lower(raw)
                if lower == "true" then return true,true end
                if lower == "false" then return true,false end
                return false,"boolean expected"
            end
            if oldType == "number" then
                local n = tonumber(raw)
                return n ~= nil,n or "number expected"
            end
            if oldType == "BrickColor" then
                local ok,v = pcall(BrickColor.new,raw)
                return ok and v ~= nil,ok and v or "invalid BrickColor"
            end
            if oldType == "Color3" then
                local r,g,b = raw:match("^%s*([%-%d%.]+)%s*[, ]%s*([%-%d%.]+)%s*[, ]%s*([%-%d%.]+)%s*$")
                if r then return true,Color3.new(tonumber(r),tonumber(g),tonumber(b)) end
                return false,"Color3 expects r,g,b"
            end
            if oldType == "Vector2" or oldType == "Vector3" then
                local nums = {}
                for token in raw:gmatch("[%-%d%.]+") do nums[#nums+1]=tonumber(token) end
                local needed = oldType == "Vector2" and 2 or 3
                if #nums >= needed then
                    if needed == 2 then return true,Vector2.new(nums[1],nums[2]) end
                    return true,Vector3.new(nums[1],nums[2],nums[3])
                end
                return false,oldType.." expects numeric components"
            end
            if oldType == "CFrame" then
                local nums = {}
                for token in raw:gmatch("[%-%d%.]+") do nums[#nums+1]=tonumber(token) end
                if #nums >= 12 then
                    return true,CFrame.new(table.unpack(nums,1,12))
                end
                return false,"CFrame expects 12 numeric components"
            end
            return false,"unsupported live conversion for "..oldType
        end
