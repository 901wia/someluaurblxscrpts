        end
        local lines = {"TARGET", "  "..tostring(pcall(function() return obj:GetFullName() end) and obj:GetFullName() or obj), ""}
        local closure
        if obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
            local getclosure = apiV5("getscriptclosure")
            if getclosure then
                local ok, value = pcall(getclosure, obj)
                if ok and type(value) == "function" then closure = value end
