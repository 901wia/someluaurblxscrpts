	Main.BuildDetailedDecompile=function(scr)
		local validTarget=false
		if scr then
			local targetOk,targetValue=pcall(function() return typeof(scr)=="Instance" and (scr:IsA("LocalScript") or scr:IsA("ModuleScript")) end)
			validTarget=targetOk and targetValue==true
		end
		if not validTarget then return nil,"DetailedDecompile requires LocalScript or ModuleScript" end
		local sections={}
		local function add(name,text)
			sections[#sections+1]={Name=name,Text=tostring(text or "")}
		end
		local path=pcall(function() return scr:GetFullName() end) and scr:GetFullName() or tostring(scr)
		add("Metadata",table.concat({"Name = "..tostring(scr.Name),"Class = "..tostring(scr.ClassName),"Path = "..path,"PlaceId = "..tostring(game.PlaceId),"GameId = "..tostring(game.GameId)},"\n"))
		local source,sourceError=getDecompiled(scr)
		add("Decompiled Source",source or "Unavailable: "..tostring(sourceError))
		local bytecode
		if type(env.getscriptbytecode)=="function" then
			local ok,value=pcall(env.getscriptbytecode,scr)
			if ok and type(value)=="string" then bytecode=value else add("Bytecode Error",tostring(value)) end
		end
		if bytecode then add("Bytecode",tostring(#bytecode).." bytes\nEncoding = Base64 when available\n"..tostring(bytesToText(bytecode))) end
		if type(env.getscripthash)=="function" then local ok,value=pcall(env.getscripthash,scr) add("Script Hash",ok and tostring(value) or "ERROR: "..tostring(value)) end
		local closure,closureError=getScriptClosure(scr)
		add("Closure",closure and tostring(closure) or "Unavailable: "..tostring(closureError))
		if closure then
			if type(env.getfunctionhash)=="function" then local ok,value=pcall(env.getfunctionhash,closure) add("Function Hash",ok and tostring(value) or "ERROR: "..tostring(value)) end
			if type(env.getinfo)=="function" then local ok,value=pcall(env.getinfo,closure) add("Function Info",ok and valueToText(value) or "ERROR: "..tostring(value)) end
			if type(env.getconstants)=="function" then local ok,value=pcall(env.getconstants,closure) add("Constants",ok and valueToText(value) or "ERROR: "..tostring(value)) end
			if type(env.getupvalues)=="function" then local ok,value=pcall(env.getupvalues,closure) add("Upvalues",ok and valueToText(value) or "ERROR: "..tostring(value)) end
			if type(env.getprotos)=="function" then local ok,value=pcall(env.getprotos,closure) add("Nested Prototypes",ok and valueToText(value) or "ERROR: "..tostring(value)) end
			if type(env.disassemble)=="function" then local ok,value=pcall(env.disassemble,closure,{Recursive=true,ShowLines=true,ShowConstants=true,StringPreviewMax=256}) add("Disassembly",ok and tostring(value) or "ERROR: "..tostring(value)) end
			if type(env.islclosure)=="function" then local ok,value=pcall(env.islclosure,closure) add("isLuaClosure",ok and tostring(value) or "ERROR: "..tostring(value)) end
			if type(env.iscclosure)=="function" then local ok,value=pcall(env.iscclosure,closure) add("isCClosure",ok and tostring(value) or "ERROR: "..tostring(value)) end
			if type(env.isnewcclosure)=="function" then local ok,value=pcall(env.isnewcclosure,closure) add("isNewCClosure",ok and tostring(value) or "ERROR: "..tostring(value)) end
			if type(env.isexecutorclosure)=="function" then local ok,value=pcall(env.isexecutorclosure,closure) add("isExecutorClosure",ok and tostring(value) or "ERROR: "..tostring(value)) end
			if type(env.isfunctionhooked)=="function" then local ok,value=pcall(env.isfunctionhooked,closure) add("isFunctionHooked",ok and tostring(value) or "ERROR: "..tostring(value)) end
		end
		if type(env.getsenv)=="function" then local ok,value=pcall(env.getsenv,scr) add("Script Environment",ok and valueToText(value) or "ERROR: "..tostring(value)) end
		if scr:IsA("ModuleScript") and type(env.getmenv)=="function" then local ok,value=pcall(env.getmenv,scr) add("Module Environment",ok and valueToText(value) or "ERROR: "..tostring(value)) end
		return sections,source,bytecode
	end
