					}
					self.Connections[#self.Connections+1] = con
					return con
				end

				funcs.Fire = function(self,...)
					local args = {...}
					for i,v in next,self.Connections do
						local callback = v.Func
						Lib.Spawn(function()
							local ok,err = xpcall(function() callback(unpack(args)) end,debug.traceback)
