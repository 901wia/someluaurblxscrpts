            Explorer.DecompileSelected = function()
                local scripts = {}
                for _,node in ipairs(selection.List) do
                    local obj = node.Obj
                    if obj:IsA("LocalScript") or obj:IsA("ModuleScript") then scripts[#scripts+1] = obj end
                end
                local win,holder = createToolWindow("Decompiler • "..tostring(#scripts).." script(s)",760,540)
                local list = createToolList(holder)
                if #scripts == 0 then
                    local _,label = toolRow(list,"Select one or more LocalScript or ModuleScript instances",28)
                    label.TextColor3 = Settings.Theme.PlaceholderText
                    win:ShowAndFocus()
                    return
                end
                local decompiler = env.decompile
                if type(decompiler) ~= "function" then
                    local _,label = toolRow(list,"decompile is unavailable in this executor",28)
                    label.TextColor3 = Settings.Theme.Important
                    win:ShowAndFocus()
                    return
                end
                local chunks = {}
                local okCount = 0
                for _,scriptObj in ipairs(scripts) do
                    local ok,source = pcall(decompiler,scriptObj)
                    if ok and type(source) == "string" and source ~= "" then
                        okCount = okCount + 1
                        chunks[#chunks+1] = "="..string.rep("=",24).."\n"..scriptObj.ClassName.." | "..scriptObj:GetFullName().."\n"..string.rep("=",26).."\n"..source
                        toolRow(list,"✓ "..scriptObj.ClassName.."  "..scriptObj:GetFullName(),26)
                    else
                        toolRow(list,"✗ "..scriptObj.ClassName.."  "..scriptObj:GetFullName().."  •  "..tostring(source),26)
                    end
                end
                local output = table.concat(chunks,"\n\n")
                local writer = env.writefile
                local mkdir = env.makefolder
                local path = "dex/decompiled/Place_"..tostring(game.PlaceId).."_"..sanitizeFileName(#scripts == 1 and scripts[1].Name or "Selection").."_"..tostring(os.time())..".luau"
                if okCount > 0 and type(writer) == "function" then
                    if type(mkdir) == "function" then pcall(mkdir,"dex") pcall(mkdir,"dex/decompiled") end
                    local saved,saveErr = pcall(writer,path,output)
                    if saved then toolRow(list,"Saved • "..path,28) else toolRow(list,"Save failed • "..tostring(saveErr),28) end
                else
                    toolRow(list,"No source was produced; nothing was written",28)
                end
                win:ShowAndFocus()
            end

