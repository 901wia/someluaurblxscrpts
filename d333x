		local function main()
			local ScriptViewer = {}

			local window,codeFrame

			ScriptViewer.ViewScript = function(scr)
				local decompiler = env.decompile
				local s,source = false,nil
				local cacheKey = tostring(scr:GetFullName())
				if type(env.getscripthash) == "function" then
					local hashOk,hash = pcall(env.getscripthash,scr)
					if hashOk and hash then cacheKey = cacheKey.."|"..tostring(hash) end
				end
				source = Main.SourceCache and Main.SourceCache[cacheKey]
				if not source and type(decompiler) == "function" then s,source = pcall(decompiler,scr) end
				if type(source) == "string" and source ~= "" then
					Main.SourceCache = Main.SourceCache or {}
					Main.SourceCache[cacheKey] = source
				else
					source = "Decompilation unavailable in this executor."
				end
				ScriptViewer.CurrentScript = scr
				codeFrame:SetText(source)
				window:Show()
			end

			ScriptViewer.Init = function()
				window = Lib.Window.new()
				window:SetTitle("Script Viewer")
