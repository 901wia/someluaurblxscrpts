    local function resolveClosure901(obj)
        if not obj then return nil,"No target selected" end
        local getter = getApi901("getscriptclosure")
        if type(getter) ~= "function" then return nil,"getscriptclosure unavailable" end
        local ok,closure = pcall(getter,obj)
        if ok and type(closure) == "function" then return closure end
        return nil,ok and "No closure returned" or tostring(closure)
    end

    local function inspectRuntime901(closure, owner)
        local lines = {"TARGET", "  "..tostring(owner and owner:GetFullName() or "function"), ""}
        local getinfo = getApi901("getinfo")
        if getinfo then
            local ok,info = pcall(getinfo,closure)
            lines[#lines+1] = "FUNCTION INFO"
            lines[#lines+1] = ok and tostring(Main.FormatInspectValue(info,0,{})) or ("ERROR: "..tostring(info))
            lines[#lines+1] = ""
        end
        local specs = {
            {"CONSTANTS","getconstants","getconstant","Constant"},
            {"UPVALUES","getupvalues","getupvalue","Upvalue"},
            {"PROTOTYPES","getprotos","getproto","Proto"},
        }
        for _,spec in ipairs(specs) do
            local heading,allName,oneName,itemName = table.unpack(spec)
            lines[#lines+1] = heading
            local allFn = getApi901(allName)
            if allFn then
                local okAll,allValue = pcall(allFn,closure)
                if okAll and type(allValue) == "table" then
                    local indexes = {}
                    for key in pairs(allValue) do if type(key) == "number" then indexes[#indexes+1] = key end end
                    table.sort(indexes)
                    local oneFn = getApi901(oneName)
                    for _,index in ipairs(indexes) do
                        local okOne,oneValue = oneFn and pcall(oneFn,closure,index) or false,nil
                        local value = okOne and oneValue or allValue[index]
                        lines[#lines+1] = "  "..itemName.."["..tostring(index).."] = "..tostring(Main.FormatInspectValue(value,0,{}))
                    end
                else
                    lines[#lines+1] = "  ERROR: "..tostring(allValue)
                end
            else
                lines[#lines+1] = "  unavailable"
            end
            lines[#lines+1] = ""
        end
        local disassemble = getApi901("disassemble")
        if disassemble then
            local ok,dis = pcall(disassemble,closure,{Recursive=true,ShowLines=true,ShowConstants=true,StringPreviewMax=256})
            lines[#lines+1] = "DISASSEMBLER"
            lines[#lines+1] = ok and tostring(dis) or ("ERROR: "..tostring(dis))
        end
        if Settings.Explorer.DeepRuntimeInspection then
            local getreg = getApi901("getreg")
            local getgc = getApi901("getgc")
            if getreg or getgc then
                lines[#lines+1] = ""
                lines[#lines+1] = "DEEP RUNTIME"
                if getreg then
                    local ok,value = pcall(getreg)
                    lines[#lines+1] = "REGISTRY = "..(ok and tostring(Main.FormatInspectValue(value,0,{})) or ("ERROR: "..tostring(value)))
                end
                if getgc then
                    local ok,value = pcall(getgc,false)
                    lines[#lines+1] = "GC OBJECTS = "..(ok and tostring(type(value)=="table" and #value or 0) or ("ERROR: "..tostring(value)))
                end
            end
        end
        return table.concat(lines,"\n")
    end

