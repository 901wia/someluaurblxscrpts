    Main.GetExecutorInfo = function()
        local name=tostring(Main.ExecutorName or "Unknown")
        local version=tostring(Main.ExecutorVersion or "Unknown")
        local function identify(fn)
            if type(fn)~="function" then return false end
            local ok,a,b=pcall(fn)
            if not ok then return false end
            if a~=nil and tostring(a)~="" then name=tostring(a) end
            if b~=nil and tostring(b)~="" then version=tostring(b) end
            return true
        end
        local function readName(fn)
            if type(fn)~="function" then return false end
            local ok,v=pcall(fn)
            if ok and v~=nil and tostring(v)~="" then name=tostring(v); return true end
            return false
        end
        local function readVersion(fn)
            if type(fn)~="function" then return false end
            local ok,v=pcall(fn)
            if ok and v~=nil and tostring(v)~="" then version=tostring(v); return true end
            return false
        end
        if not identify(rawget(env or {},"identifyexecutor")) then identify(rawget(_G,"identifyexecutor")) end
        if name=="Unknown" then
            local envName=readName(rawget(env or {},"getexecutorname"))
            if not envName then readName(rawget(_G,"getexecutorname")) end
        end
        if version=="Unknown" then
            local envVersion=readVersion(rawget(env or {},"getexecutorversion"))
            if not envVersion then readVersion(rawget(_G,"getexecutorversion")) end
        end
        Main.ExecutorName=name
        Main.ExecutorVersion=version
        return name,version
    end

