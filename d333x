    local function bytesFromV8(value)
        if type(value)=="string" then
            local out={}
            for i=1,#value do out[i]=string.byte(value,i) end
            return out
        end
        if typeof(value)=="buffer" then
            local ok,size=pcall(buffer.len,value)
            if ok and size then
                local out={}
                for i=0,size-1 do local okByte,b=pcall(buffer.readu8,value,i); if not okByte then return nil end; out[#out+1]=b end
                return out
            end
        end
        if type(value)=="table" then
            local out={}
            for i=1,#value do local n=tonumber(value[i]); if not n or n<0 or n>255 then return nil end; out[i]=math.floor(n) end
            return out
        end
        return nil
    end

    local function hexToBytesV8(text)
        local cleaned=tostring(text or ""):gsub("0[xX]",""):gsub("[^%x]","")
        if cleaned=="" or #cleaned%2~=0 then return nil end
        local out={}
        for i=1,#cleaned,2 do
            local n=tonumber(cleaned:sub(i,i+1),16)
            if not n then return nil end
            out[#out+1]=n
        end
        return out
    end

    local function bytesToHexV8(bytes)
        if not bytes then return "" end
        local out={}
        for i=1,#bytes do out[i]=string.format("%02X",bytes[i]) end
        return table.concat(out," ")
    end

    local function bytesToAsciiV8(bytes)
        if not bytes then return "" end
        local out={}
        for i=1,#bytes do local b=bytes[i]; out[i]=(b>=32 and b<=126) and string.char(b) or "." end
        return table.concat(out)
    end

