				local clip = env.setclipboard or setclipboard
				if type(clip) == "function" then pcall(clip,tostring(text or "")) end
			end

			Properties.CopyAttributes = function(objects)
				local source
				if type(objects) == "table" then
					for _,value in ipairs(objects) do
						if typeof(value) == "Instance" then source = value break end
						if type(value) == "table" and value.Obj then source = value.Obj break end
					end
				end
				if not source then
					local list = Explorer.Selection and Explorer.Selection.List or {}
					local node = list[1]
					source = node and node.Obj
				end
				if not source then return false end
				local attrs = getAttributes(source)
				local copy = {}
				local printable = {}
				for name,value in pairs(attrs or {}) do
					local prop = {ValueType = {Name = Properties.TypeNameConvert[typeof(value)] or typeof(value)}}
					local valueText = Properties.ValueToString(prop,value)
					copy[#copy+1] = {Name=tostring(name),Type=typeof(value),Value=value,Text=valueText}
					printable[#printable+1] = tostring(name).." = ("..tostring(typeof(value))..") "..tostring(valueText)
				end
				table.sort(copy,function(a,b) return a.Name < b.Name end)
				Properties.AttributeClipboard = copy
				attributeClipboardNotice(table.concat(printable,"\n"))
				return true
			end

			Properties.PasteAttributes = function()
				local attrs = Properties.AttributeClipboard
				if type(attrs) ~= "table" then return false end
				local list = Explorer.Selection and Explorer.Selection.List or {}
				local changed = false
				for _,node in ipairs(list) do
					local obj = node and node.Obj
					if obj then
						for _,item in ipairs(attrs) do
							local ok = pcall(function() setAttribute(obj,item.Name,item.Value) end)
							if ok then changed = true end
						end
					end
				end
				if changed then Properties.ShowExplorerProps() end
				return changed
			end

