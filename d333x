        if filter=="" then return true end
        for token in string.gmatch(filter,"[^,%s]+") do
            local ok=pcall(function() return obj:IsA(token) end)
            if obj.ClassName==token or (ok and obj:IsA(token)) then return true end
        end
        return false
    end

    local function matchesName901(obj,filter)
