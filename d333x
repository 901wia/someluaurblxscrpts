	local function captureSource(scr)
		if not scr or not (scr:IsA("LocalScript") or scr:IsA("ModuleScript")) then return nil end
		if type(env.decompile) ~= "function" then return nil end
		Main.SourceCache = Main.SourceCache or {}
		local key = instancePath(scr)
		if type(env.getscripthash) == "function" then
			local ok,hash = pcall(env.getscripthash,scr)
			if ok and hash then key = key.."|"..tostring(hash) end
		end
		if Main.SourceCache[key] then return Main.SourceCache[key],key end
		local ok,source = pcall(env.decompile,scr)
		if ok and type(source) == "string" and source ~= "" then
			Main.SourceCache[key] = source
			return source,key
		end
		return nil,key
	end
