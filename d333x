    local function inspectValue(value, depth, seen)
        depth = depth or 0
        seen = seen or {}
        if Main.FormatInspectValue then
            local ok, text = pcall(Main.FormatInspectValue, value, depth, seen)
            if ok then return tostring(text) end
        end
        local valueType = typeof(value)
        if value == nil then return "nil" end
        if valueType == "string" then return string.format("%q", value) end
        if valueType ~= "table" then return tostring(value) end
        if depth >= 5 then return "<table>" end
        if seen[value] then return "<cycle>" end
        seen[value] = true
        local keys = {}
        for key in pairs(value) do keys[#keys + 1] = key end
        table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
        local rows = {"{"}
        for index, key in ipairs(keys) do
            if index > 800 then
                rows[#rows + 1] = "  ..."
                break
            end
            rows[#rows + 1] = "  [" .. tostring(key) .. "] = " .. inspectValue(value[key], depth + 1, seen)
        end
        rows[#rows + 1] = "}"
        seen[value] = nil
        return table.concat(rows, "\n")
    end
    local function numericKeys(value, cap)
        local out = {}
        if type(value) ~= "table" then return out end
        for key in pairs(value) do
            if type(key) == "number" then out[#out + 1] = key end
        end
        table.sort(out)
        if #out > (cap or 600) then
            for i = #out, (cap or 600) + 1, -1 do out[i] = nil end
        end
        return out
    end
    local function accessorText(target, allName, oneName, title)
