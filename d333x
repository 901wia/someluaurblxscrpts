			addSection(right,"Inspector Stack Snapshot",#lines>0 and table.concat(lines,"\n\n") or "No readable stack levels")
		end
		if type(env.disassemble)=="function" then local ok,value=pcall(env.disassemble,target,{Recursive=true,ShowLines=true,ShowConstants=true,StringPreviewMax=256}) addSection(right,"Disassembly",ok and tostring(value) or "ERROR: "..tostring(value)) end
		local source=owner and Main.CaptureSource(owner) or nil
