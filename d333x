    Main.RequestClassAsset = function(className)
        if Settings.Explorer.AssetIcons == false then return nil end

        local key = tostring(className or "Unspecified")
        local cached = Main.AssetCache901[key]
        if cached ~= nil then
            return cached or nil
        end
        if Main.AssetLoading901[key] then return nil end

        local getAsset = assetGetEnv("getcustomasset")
        local writer = assetGetEnv("writefile")
        local checker = assetGetEnv("isfile")
        if type(getAsset) ~= "function" then
            return nil
        end

        local candidates = {}
        local seen = {}
        local function addCandidate(name)
            name = tostring(name or "")
            if name ~= "" and not seen[name] then
                seen[name] = true
                candidates[#candidates + 1] = name
            end
        end

        if knownAssets[key] then addCandidate(key) end
        addCandidate(assetAliases[key])
        addCandidate("Unspecified")

        Main.AssetLoading901[key] = true
        assetEnsureFolder()

        task.spawn(function()
            local taskOk, found = pcall(function()
                local result = nil
                for _, candidate in ipairs(candidates) do
                    if result then break end
                    local path = Main.AssetFolder901 .. "/" .. assetSafeName(candidate) .. ".png"
                    local exists = false
                    if type(checker) == "function" then
                        local ok, value = pcall(checker,path)
                        exists = ok and value == true
                    end

                    if exists then
                        local ok, assetId = pcall(getAsset,path)
                        if ok and type(assetId) == "string" and assetId ~= "" then
                            result = assetId
                            break
                        end
                    elseif type(writer) == "function" then
                        local roots = {Main.AssetRoot901,Main.AssetFallbackRoot901}
                        for _, root in ipairs(roots) do
                            local body = assetRequest(root .. assetSafeName(candidate) .. ".png")
                            if body then
                                local wrote = pcall(writer,path,body)
                                if wrote then
                                    local ok, assetId = pcall(getAsset,path)
                                    if ok and type(assetId) == "string" and assetId ~= "" then
                                        result = assetId
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
                return result
            end)

            Main.AssetLoading901[key] = nil
            if not taskOk then found = nil end
            Main.AssetCache901[key] = found or false
            if found and Explorer and type(Explorer.ForceUpdate) == "function" and not Main.Destroyed then
