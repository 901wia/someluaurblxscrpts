	Main.FormatInspectValue = function(value,depth,seen)
		depth=depth or 0
		seen=seen or {}
		local tv=type(value)
		if value==nil then return "nil" end
		if tv=="string" then return string.format("%q",value) end
		if tv=="number" or tv=="boolean" then return tostring(value) end
		if tv=="function" then return "function "..tostring(value) end
		if tv=="thread" then return "thread "..tostring(value) end
		if tv~="table" then return tostring(value) end
		if seen[value] then return "<cycle>" end
		if depth>=3 then return "<table>" end
		seen[value]=true
		local result={}
		local count=0
		for key,item in pairs(value) do
			count=count+1
			if count>50 then result[#result+1]="..." break end
			result[#result+1]="["..Main.FormatInspectValue(key,depth+1,seen).."] = "..Main.FormatInspectValue(item,depth+1,seen)
		end
		seen[value]=nil
		return "{ "..table.concat(result,", ").." }"
	end

	Main.CompileArgs = function(source)
		local clean=tostring(source or ""):gsub("^%s+",""):gsub("%s+$","")
		if clean=="" then return {} end
		local loader=env.loadstring or loadstring
		if type(loader)~="function" then return nil,"loadstring is unavailable" end
		local fn,compileError=loader("return {"..clean.."}")
		if type(fn)~="function" then return nil,tostring(compileError) end
		local ok,result=pcall(fn)
		if not ok then return nil,tostring(result) end
		if type(result)~="table" then return nil,"invalid argument result" end
		return result
	end

	Main.ResolveAPIPath = function(path)
		local parts={}
		for part in tostring(path or ""):gmatch("[^%.]+") do parts[#parts+1]=part end
		if #parts==0 then return nil end
		local roots={env}
		if type(getgenv)=="function" then
			local ok,g=pcall(getgenv)
			if ok and type(g)=="table" then roots[#roots+1]=g end
		end
		roots[#roots+1]=_G
		for _,root in ipairs(roots) do
			local value=root
			local valid=true
			for _,part in ipairs(parts) do
				local ok,nextValue=pcall(function() return value[part] end)
				if not ok or nextValue==nil then valid=false break end
				value=nextValue
			end
			if valid then return value end
		end
		return nil
	end

