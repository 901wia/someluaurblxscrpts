            lines[#lines + 1] = ""
            return
        end
        local ok,allValue = pcall(allFn,closure)
        if not ok then
            lines[#lines + 1] = "  ERROR: " .. tostring(allValue)
            lines[#lines + 1] = ""
            return
        end
        if type(allValue) ~= "table" then
            lines[#lines + 1] = "  " .. inspectV8(allValue)
            lines[#lines + 1] = ""
            return
        end
        local indexes = {}
        for key in pairs(allValue) do if type(key) == "number" then indexes[#indexes + 1] = key end end
        table.sort(indexes)
        local oneFn = apiV8(oneName)
        for _,index in ipairs(indexes) do
            local value = allValue[index]
            if type(oneFn) == "function" then
                local okOne,oneValue = pcall(oneFn,closure,index)
                if okOne then value = oneValue end
            end
            lines[#lines + 1] = "  [" .. tostring(index) .. "] = " .. inspectV8(value)
        end
        lines[#lines + 1] = ""
    end

