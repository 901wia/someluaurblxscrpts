                end
            end
            lines[#lines + 1] = line
        end
        return #lines > 0 and table.concat(lines, "\n") or "getprotos = {}"
    end
    local function signatureText(object)
        local signalNames = {"OnClientEvent", "OnServerEvent", "OnClientInvoke", "OnServerInvoke", "OnClientEventUnreliable", "OnServerEventUnreliable"}
        for _, name in ipairs(signalNames) do
            local ok, signal = pcall(Reflection.Read, object, name)
            if ok and signal then
                local okInfo, info = api("getsignalargumentsinfo", signal)
                if okInfo and type(info) == "table" then
                    local parts = {}
                    for _, item in ipairs(info) do parts[#parts + 1] = tostring(item.Name or "arg") .. ":" .. tostring(item.Type or "Variant") end
                    return table.concat(parts, ", "), name
                end
            end
        end
        return "Variant", nil
    end
    local function safeJSON(value)
        local ok, text = pcall(function() return service.HttpService:JSONEncode(value) end)
        return ok and text or nil
    end
    local function buildDetailed(object)
        if not isScript(object) then return nil, "DetailedDecompile requires LocalScript or ModuleScript" end
        local sections = {}
        local function add(name, text) sections[#sections + 1] = {Name = name, Text = tostring(text or "")} end
        add("Target", table.concat({
            "Name = " .. tostring(object.Name),
            "Class = " .. tostring(object.ClassName),
            "Path = " .. fullName(object),
            "PlaceId = " .. tostring(game.PlaceId),
            "GameId = " .. tostring(game.GameId),
            "JobId = " .. tostring(game.JobId)
        }, "\n"))
        local source, sourceErr = getSource(object)
        add("Decompiled Source", source or "Unavailable: " .. tostring(sourceErr))
        local bytecode, byteSource = getBytecode(object)
        if bytecode then
            local encoded
            local ok64, value64 = api("base64_encode", bytecode)
            if ok64 and type(value64) == "string" then encoded = value64 end
            add("Raw Bytecode", "Reader = " .. tostring(byteSource) .. "\nLength = " .. tostring(#bytecode) .. " bytes\nBase64 = " .. tostring(encoded or "unavailable"))
        else
            add("Raw Bytecode", "Unavailable")
        end
        local okHash, scriptHash, hashErr = api("getscripthash", object)
        add("Script Hash", okHash and tostring(scriptHash) or "Unavailable: " .. tostring(hashErr))
        local closure, closureErr = getClosure(object)
        if closure then
            add("Closure", tostring(closure))
            local okFnHash, fnHash, fnHashErr = api("getfunctionhash", closure)
            add("Function Hash", okFnHash and tostring(fnHash) or "Unavailable: " .. tostring(fnHashErr))
            local okInfo, info, infoErr = api("getinfo", closure)
            add("Function Info", okInfo and inspectValue(info) or "Unavailable: " .. tostring(infoErr))
            add("Constants + getconstant", accessorText(closure, "getconstants", "getconstant", "Constant"))
            add("Upvalues + getupvalue", accessorText(closure, "getupvalues", "getupvalue", "Upvalue"))
            add("Nested Prototypes + getproto", protoText(closure))
            local okDis, dis, disErr = api("disassemble", closure, {Recursive = true, ShowLines = true, ShowConstants = true, StringPreviewMax = 256})
            add("Disassembler", okDis and tostring(dis) or "Unavailable: " .. tostring(disErr))
            local capabilities = {}
            for _, name in ipairs({"islclosure", "iscclosure", "isnewcclosure", "isexecutorclosure", "isfunctionhooked", "ishiddenstack"}) do
                local okCap, valueCap, errCap = api(name, closure)
                capabilities[#capabilities + 1] = name .. " = " .. (okCap and tostring(valueCap) or "ERROR: " .. tostring(errCap))
            end
            add("Closure Capabilities", table.concat(capabilities, "\n"))
            local okThread, thread, threadErr = api("getscriptthread", object)
            if okThread and type(thread) == "thread" then
                local runtime = {"thread = " .. tostring(thread)}
                local okId, identity = api("getthreadidentity", thread)
                if okId then runtime[#runtime + 1] = "identity = " .. tostring(identity) end
                local okOur, our = api("isourthread", thread)
                if okOur then runtime[#runtime + 1] = "isourthread = " .. tostring(our) end
                if Settings.Explorer.DeepRuntimeInspection then
                    local okTen, tenv = api("gettenv", thread)
                    if okTen then runtime[#runtime + 1] = "thread environment = " .. inspectValue(tenv) end
                end
                add("Script Thread", table.concat(runtime, "\n"))
            else
                add("Script Thread", "Unavailable: " .. tostring(threadErr))
            end
        else
            add("Closure", "Unavailable: " .. tostring(closureErr))
        end
        local okEnv, valueEnv, errEnv = api("getsenv", object)
        add("Script Environment", okEnv and inspectValue(valueEnv) or "Unavailable: " .. tostring(errEnv))
        if object:IsA("ModuleScript") then
            local okMen, moduleEnv, menErr = api("getmenv", object)
            add("Module Environment", okMen and inspectValue(moduleEnv) or "Unavailable: " .. tostring(menErr))
        end
        if Settings.Explorer.DeepRuntimeInspection and closure then
            local okReg, registry, regErr = api("getreg")
            add("Registry Summary", okReg and inspectValue(registry) or "Unavailable: " .. tostring(regErr))
            local okGc, gc, gcErr = api("getgc", false)
            add("GC Summary", okGc and "Objects = " .. tostring(type(gc) == "table" and #gc or 0) or "Unavailable: " .. tostring(gcErr))
        end
        if not source and closure then
            local okDis, dis, disErr = api("disassemble", closure, {Recursive = true, ShowLines = true, ShowConstants = true, StringPreviewMax = 256})
            add("Decompiler Fallback", okDis and tostring(dis) or "Unavailable: " .. tostring(disErr))
        end
        return sections, source, bytecode
    end
    Main.BuildDetailedDecompile = buildDetailed
    Main.FormatDetailedDecompile = function(object)
        local sections, source, bytecode = buildDetailed(object)
        if not sections then return nil, source end
        local out = {"DetailedDecompile", ""}
        for _, section in ipairs(sections) do
            out[#out + 1] = "===== " .. section.Name .. " ====="
            out[#out + 1] = section.Text
            out[#out + 1] = ""
        end
        return table.concat(out, "\n"), source, bytecode
    end
    Main.DetailedDecompile = function(objects)
        local scripts, seen = {}, {}
        for _, object in ipairs(objects or {}) do
            if object and not seen[object] and isScript(object) then
                seen[object] = true
                scripts[#scripts + 1] = object
            end
        end
        if #scripts == 0 then return nil, "No LocalScript or ModuleScript selected" end
        local chunks = {}
        for index, object in ipairs(scripts) do
            local text = Main.FormatDetailedDecompile(object)
            chunks[#chunks + 1] = "===== SCRIPT " .. tostring(index) .. " | " .. object.ClassName .. " | " .. fullName(object) .. " ====="
            chunks[#chunks + 1] = text or ""
            chunks[#chunks + 1] = ""
            if index % 2 == 0 then task.wait() end
        end
        local output = table.concat(chunks, "\n")
        local path = "dex/decompiled/" .. safeName(#scripts == 1 and scripts[1].Name or "Selection") .. "_Detailed_" .. tostring(os.time()) .. ".txt"
        local ok, err = writeFile(path, output)
        if not ok then return nil, err end
        copyText(output)
        return path, output
    end
    Main.DecompileToWorkspace = function(objects)
        local scripts, seen = {}, {}
        for _, object in ipairs(objects or {}) do
            if object and not seen[object] and isScript(object) then
                seen[object] = true
                scripts[#scripts + 1] = object
            end
        end
        if #scripts == 0 then return nil, "No LocalScript or ModuleScript selected" end
        local chunks = {}
        local failed = {}
        for index, object in ipairs(scripts) do
            local source, err = getSource(object)
            if source then
                if #scripts == 1 then chunks[#chunks + 1] = source else chunks[#chunks + 1] = "===== " .. object.ClassName .. " | " .. fullName(object) .. " =====\n" .. source end
            else
                failed[#failed + 1] = fullName(object) .. " => " .. tostring(err)
            end
            if index % 2 == 0 then task.wait() end
        end
        if #chunks == 0 then
            for _, object in ipairs(scripts) do
                local closure = getClosure(object)
                if closure then
                    local okDis, dis = api("disassemble", closure, {Recursive = true, ShowLines = true, ShowConstants = true, StringPreviewMax = 256})
                    chunks[#chunks + 1] = "===== DISASSEMBLY | " .. fullName(object) .. " =====\n" .. (okDis and tostring(dis) or "Disassembler unavailable")
                else
                    local bytes = getBytecode(object)
                    chunks[#chunks + 1] = "===== BYTECODE | " .. fullName(object) .. " =====\nLength = " .. tostring(bytes and #bytes or 0)
                end
            end
        end
        if #failed > 0 then chunks[#chunks + 1] = "\n===== UNAVAILABLE =====\n" .. table.concat(failed, "\n") end
        local output = table.concat(chunks, "\n\n")
        local extension = #scripts == 1 and ".luau" or ".txt"
        local path = "dex/decompiled/" .. safeName(#scripts == 1 and scripts[1].Name or "Selection") .. "_" .. tostring(os.time()) .. extension
        local ok, err = writeFile(path, output)
        if not ok then return nil, err end
        return path, output
    end
