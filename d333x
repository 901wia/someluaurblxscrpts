    local function unregisterContextV8(context,id)
        if not context then return end
        local fn = context.UnRegister or context.Unregister
        if type(fn) == "function" then pcall(fn,context,id) end
        if context.Registered then context.Registered[id] = nil end
        if context.Items then context.Items[id] = nil end
    end

    local function safeContextV8(context)
        if not context or context._SafeV8 then return end
        context._SafeV8 = true
        local original = context.AddRegistered
        if type(original) == "function" then
            context._OriginalAddRegisteredV8 = original
            context.AddRegistered = function(self,id,disabled)
                if type(id) ~= "string" then return nil end
                if self.Registered and self.Registered[id] == nil then return nil end
                local ok,value = pcall(original,self,id,disabled)
                return ok and value or nil
            end
        end
        local seen = {}
        if context.Registered then
            for id,item in pairs(context.Registered) do
                local label = string.lower(tostring(item and item.Name or "")):gsub("[^%w]","")
                local key = label
                if label == "decompilermenu" then key = "decompilermenu" end
                if label == "viewobjectrightclicktoreset" or label == "viewobject" then key = "viewobject" end
                if seen[key] then
                    unregisterContextV8(context,id)
                else
                    seen[key] = id
                end
            end
        end
    end

