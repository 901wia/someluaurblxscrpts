			Explorer.DuplicateSelection = function()
				local source = selection.List
				if #source == 0 then return end
				local newSelection = {}
				for _,node in ipairs(source) do
					local inst = node.Obj
					local parent = node.Parent and node.Parent.Obj
					local ok,cloned = pcall(function() return inst:Clone() end)
					if ok and cloned then
						local parentOk = pcall(function() cloned.Parent = parent end)
						if parentOk and parent and not nodes[cloned] then pcall(addObject,cloned) end
						local clonedNode = nodes[cloned]
						if clonedNode then newSelection[#newSelection+1] = clonedNode end
					end
				end
				selection:SetTable(newSelection)
				if newSelection[1] then Explorer.ViewNode(newSelection[1]) end
			end

