		action("Export JSON",232,102,function() if type(env.makefolder)=="function" then pcall(env.makefolder,"dex") pcall(env.makefolder,"dex/inspectors") end if type(env.writefile)~="function" then state.Text="writefile unavailable" return end local payload={Object=ownerPath,Sections=structured} local okJson,jsonText=pcall(service.HttpService.JSONEncode,service.HttpService,payload) if not okJson then state.Text="JSON encode failed" return end local base=Main.SanitizeFileName((info and (info.name or info.short_src)) or (owner and owner.Name) or "Closure") local path="dex/inspectors/"..base.."_"..tostring(os.time())..".json" local ok=pcall(env.writefile,path,jsonText) state.Text=ok and ("Saved: "..path) or "Export failed" end)
