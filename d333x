			Properties.StringToValue = function(prop,str)
				local typeData = prop.ValueType
				local typeName = typeData.Name
				str = tostring(str or "")
				str = str:gsub("^%s+",""):gsub("%s+$","")

				if typeName == "string" or typeName == "Content" then
					return str
				elseif Properties.ToNumberTypes[typeName] then
					return tonumber(str)
				elseif typeName == "Vector2" then
					local vals = str:gsub("[{}]",""):split(",")
					local x,y = tonumber(vals[1]),tonumber(vals[2])
					if x and y and #vals >= 2 then return Vector2.new(x,y) end
				elseif typeName == "Vector3" then
					local vals = str:gsub("[{}]",""):split(",")
					local x,y,z = tonumber(vals[1]),tonumber(vals[2]),tonumber(vals[3])
					if x and y and z and #vals >= 3 then return Vector3.new(x,y,z) end
				elseif typeName == "UDim" then
					local vals = str:gsub("[{}]",""):split(",")
					local scale,offset = tonumber(vals[1]),tonumber(vals[2])
					if scale and offset and #vals >= 2 then return UDim.new(scale,offset) end
				elseif typeName == "UDim2" then
					local vals = str:gsub("[{}]",""):split(",")
					local xScale,xOffset,yScale,yOffset = tonumber(vals[1]),tonumber(vals[2]),tonumber(vals[3]),tonumber(vals[4])
					if xScale and xOffset and yScale and yOffset and #vals >= 4 then return UDim2.new(xScale,xOffset,yScale,yOffset) end
				elseif typeName == "CFrame" then
					local vals = str:gsub("[{}]",""):split(",")
					local numbers = {}
					for i = 1,math.min(#vals,12) do
						numbers[i] = tonumber(vals[i])
						if numbers[i] == nil then return nil end
					end
					if #numbers >= 12 then return CFrame.new(unpack(numbers,1,12)) end
					if #numbers == 3 then return CFrame.new(numbers[1],numbers[2],numbers[3]) end
				elseif typeName == "Rect" then
					local vals = str:gsub("[{}]",""):split(",")
					local a,b,c,d = tonumber(vals[1]),tonumber(vals[2]),tonumber(vals[3]),tonumber(vals[4])
					if a and b and c and d then return Rect.new(a,b,c,d) end
				elseif typeName == "NumberRange" then
					local vals = str:gsub("[{}]",""):split(",")
					local a,b = tonumber(vals[1]),tonumber(vals[2] or vals[1])
					if a and b then return NumberRange.new(a,b) end
				elseif typeName == "Color3" then
					local vals = str:gsub("[{}]",""):split(",")
					local a,b,c = tonumber(vals[1]),tonumber(vals[2]),tonumber(vals[3])
					if a and b and c then return Color3.fromRGB(a,b,c) end
				elseif typeName == "Font" then
					local family,weightName,styleName = str:match("^(.-)%s*|%s*(.-)%s*|%s*(.-)%s*$")
					if family and weightName and styleName and Font then
						local weightKey = weightName:gsub("^%s+",""):gsub("%s+$","")
						local styleKey = styleName:gsub("^%s+",""):gsub("%s+$","")
						local okWeight,weight = pcall(function() return Enum.FontWeight[weightKey] end)
						local okStyle,style = pcall(function() return Enum.FontStyle[styleKey] end)
						if okWeight and okStyle and weight and style then
							local ok,result = pcall(Font.new,family,weight,style)
							if ok then return result end
							local okFromName,resultFromName = pcall(Font.fromName,family,weight,style)
							if okFromName then return resultFromName end
						end
					end
					local okEnum,enumFont = pcall(function() return Enum.Font[str] end)
					if okEnum and enumFont and Font.fromEnum then
						local ok,result = pcall(Font.fromEnum,enumFont)
						if ok then return result end
					end
				end

				return nil
			end

			Properties.ValueToString = function(prop,val)
				local typeData = prop.ValueType
				local typeName = typeData.Name
				if val == nil then return "nil" end
				if typeName == "Color3" then
					return Lib.ColorToBytes(val)
				elseif typeName == "NumberRange" then
					return tostring(val.Min)..", "..tostring(val.Max)
				elseif typeName == "CFrame" then
					local ok,a,b,c,d,e,f,g,h,i,j,k,l = pcall(function() return val:GetComponents() end)
					if ok then return table.concat({a,b,c,d,e,f,g,h,i,j,k,l},", ") end
				elseif typeName == "Font" then
					local ok,family,weight,style = pcall(function() return tostring(val.Family),tostring(val.Weight.Name),tostring(val.Style.Name) end)
					if ok then return family.." | "..weight.." | "..style end
				end
				return tostring(val)
			end

			Properties.GetIndexableProps = function(obj,classData)
				if not Main.Elevated then
					if not pcall(function() return obj.ClassName end) then return nil end
				end

				local ignoreProps = Properties.IgnoreProps[classData.Name] or {}

				local result = {}
				local count = 1
				local props = classData.Properties
				for i = 1,#props do
					local prop = props[i]
					if not ignoreProps[prop.Name] then
						local s = pcall(function() return obj[prop.Name] end)
						if s then
							result[count] = prop
							count = count + 1
						end
					end
				end

				return result
			end

