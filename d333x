    local function inspect(value,depth,seen)
        depth = depth or 0
        seen = seen or {}
        if value == nil then return "nil" end
        local tv = type(value)
        if tv == "string" then return string.format("%q",value) end
        if tv == "number" or tv == "boolean" then return tostring(value) end
        if tv == "function" then return "function "..tostring(value) end
        if tv == "thread" then return "thread "..tostring(value) end
        if tv ~= "table" then return tostring(value) end
        if seen[value] then return "<cycle>" end
        if depth >= 4 then return "<table>" end
        seen[value] = true
        local keys = {}
        for key in pairs(value) do keys[#keys+1] = key end
        table.sort(keys,function(a,b) return tostring(a) < tostring(b) end)
        local parts = {}
        for i,key in ipairs(keys) do
            if i > 80 then parts[#parts+1] = "..." break end
            parts[#parts+1] = "["..inspect(key,depth+1,seen).."] = "..inspect(value[key],depth+1,seen)
        end
        seen[value] = nil
        return "{ "..table.concat(parts,", ").." }"
    end

