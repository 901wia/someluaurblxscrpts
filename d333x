    local function inspectV8(value,depth,seen)
        depth = depth or 0
        seen = seen or {}
        if depth > 5 then return "<depth-limit>" end
        local valueType = typeof(value)
        if valueType == "nil" then return "nil" end
        if valueType == "string" then return string.format("%q",value) end
        if valueType == "Instance" then
            local ok,full = pcall(function() return value:GetFullName() end)
            return ok and tostring(full) or tostring(value)
        end
        if valueType == "EnumItem" then return tostring(value) end
        if valueType == "Vector2" or valueType == "Vector2int16" then return tostring(value) end
        if valueType == "Vector3" or valueType == "Vector3int16" then return tostring(value) end
        if valueType == "CFrame" or valueType == "Color3" or valueType == "BrickColor" or valueType == "UDim" or valueType == "UDim2" or valueType == "NumberRange" or valueType == "NumberSequence" or valueType == "ColorSequence" or valueType == "Rect" or valueType == "Font" then return tostring(value) end
        if type(value) ~= "table" then return tostring(value) end
        if seen[value] then return "<cycle>" end
        seen[value] = true
        local keys = {}
        for key in pairs(value) do keys[#keys + 1] = key end
        table.sort(keys,function(a,b) return tostring(a) < tostring(b) end)
        local out = {"{"}
        for _,key in ipairs(keys) do
            out[#out + 1] = string.rep("  ",depth + 1) .. tostring(key) .. " = " .. inspectV8(value[key],depth + 1,seen)
        end
        out[#out + 1] = string.rep("  ",depth) .. "}"
        seen[value] = nil
        return table.concat(out,"\n")
    end

