            local function compileArgumentList(source)
                local clean = tostring(source or ""):gsub("^%s+",""):gsub("%s+$","")
                if clean == "" then return {} end
                local loader = env.loadstring or loadstring
                if type(loader) ~= "function" then return nil,"loadstring is unavailable" end
                local chunk,compileError = loader("return {"..clean.."}")
                if type(chunk) ~= "function" then return nil,tostring(compileError) end
                local ok,result = pcall(chunk)
                if not ok then return nil,tostring(result) end
                if type(result) ~= "table" then return nil,"argument expression did not produce a table" end
                return result
            end

            local function memberSignature(member)
                local parts = {}
                for _,parameter in ipairs(member and member.Parameters or {}) do
                    parts[#parts+1] = tostring(parameter.Name or "arg")..":"..tostring(parameter.Type or "any")
                end
                if #parts == 0 then return "()" end
                return "("..table.concat(parts,", ")..")"
            end

            local function findMember(className,bucket,name)
                local members = API.GetMember and API.GetMember(className,bucket) or {}
                for _,member in ipairs(members or {}) do
                    if member.Name == name then return member end
                end
                return nil
            end

            local function getSignalInfo(signal)
                local result = {}
                local infoFn = env.getsignalargumentsinfo
                local argsFn = env.getsignalarguments
                if type(infoFn) == "function" then
                    local ok,data = pcall(infoFn,signal)
                    if ok and type(data) == "table" then result.info = data end
                end
                if type(argsFn) == "function" then
                    local ok,data = pcall(argsFn,signal)
                    if ok and type(data) == "table" then result.arguments = data end
                end
                return result
            end

            local function describeConnection(connection)
                local parts = {}
                local stateOk,state = pcall(function() return connection.Enabled end)
                if stateOk and state ~= nil then parts[#parts+1] = state and "Enabled" or "Disabled" end
                local foreignOk,foreign = pcall(function() return connection.ForeignState end)
                if foreignOk and foreign ~= nil then parts[#parts+1] = "ForeignState="..tostring(foreign) end
                local fnOk,fn = pcall(function() return connection.Function end)
                if fnOk and type(fn) == "function" then
                    local getInfo = env.getinfo or (debug and debug.getinfo)
                    if type(getInfo) == "function" then
                        local ok,info = pcall(getInfo,fn)
                        if ok and type(info) == "table" then
                            parts[#parts+1] = "params="..tostring(info.numparams or info.nparams or "?")
                            if info.name and info.name ~= "" then parts[#parts+1] = "name="..tostring(info.name) end
                        end
                    end
                end
                return #parts > 0 and table.concat(parts," • ") or "connection"
            end

