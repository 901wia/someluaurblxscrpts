Main.Ultimate901Patch = function()
    local function api(name, ...)
        local fn = env and env[name] or nil
        if type(fn) ~= "function" then
            fn = _G[name]
        end
        if type(fn) ~= "function" then
            return false, nil, tostring(name) .. " unavailable"
        end
        local ok, a, b, c, d, e = pcall(fn, ...)
        if not ok then
            return false, nil, tostring(a)
        end
        return true, a, b, c, d, e
    end
    local function safeName(value)
        local text = tostring(value or "Output")
        text = text:gsub("[^%w_%- ]", "_")
        text = text:gsub("%s+", "_")
        if text == "" then text = "Output" end
        return text:sub(1, 96)
    end
    local function ensureFolder(path)
        local maker = env and env.makefolder or makefolder
        local checker = env and env.isfolder or isfolder
        if type(maker) ~= "function" then return end
        pcall(function()
            local parts = {}
            for part in tostring(path):gmatch("[^/]+") do parts[#parts + 1] = part end
            local current = ""
            for _, part in ipairs(parts) do
                current = current == "" and part or current .. "/" .. part
                if type(checker) ~= "function" or not checker(current) then pcall(maker, current) end
            end
        end)
    end
    local function writeFile(path, content)
        local writer = env and env.writefile or writefile
        if type(writer) ~= "function" then return false, "writefile unavailable" end
        ensureFolder(path:match("^(.*)/[^/]+$") or "")
