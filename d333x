    Main.OpenEventConnectionsInspector = function(obj)
        obj=obj or selected901()
        if not obj then show901("Viewer · Event Connections","Nothing selected.") return end
        local getconnections=api901("getconnections")
        if not getconnections then
            show901("Viewer · Event Connections","getconnections is unavailable in this runtime.")
            return
        end
        local lines={"TARGET", "  "..safeFullName901(obj), ""}
        local classInfo=API.GetMember and API.GetMember(obj.ClassName,"Events") or {}
        if type(classInfo)~="table" or #classInfo==0 then
            lines[#lines+1]="No API-described events found for this class.\n\nTip: if the runtime exposes a signal property directly, the connection list can still be inspected through the lower-level API."
            show901("Viewer · Event Connections",table.concat(lines,"\n\n"),safeFullName901(obj))
            return
        end
        local total=0
        for _,event in ipairs(classInfo) do
            local signal=nil
            pcall(function() signal=obj[event.Name] end)
            if signal then
                local ok,connections=pcall(getconnections,signal)
                if ok and type(connections)=="table" then
                    lines[#lines+1]=string.upper(tostring(event.Name)).." · "..tostring(#connections).." connection(s)"
                    for index,connection in ipairs(connections) do
                        total+=1
                        local entry={"  Connection #"..tostring(index)}
                        for _,key in ipairs({"Enabled","Fires","LuaConnection","Thread","Function"}) do
                            local okv,v=pcall(function() return connection[key] end)
                            if okv and v~=nil then
                                if key=="Function" and type(v)=="function" then
                                    entry[#entry+1]=functionSummary901(v,"Function")
                                else
                                    entry[#entry+1]="    "..key.." = "..inspect901(v)
                                end
                            end
                        end
                        lines[#lines+1]=table.concat(entry,"\n")
                    end
                    lines[#lines+1]=""
                end
            end
        end
        local callbackProps={"OnInvoke","OnServerInvoke","OnClientInvoke","OnServerEvent","OnClientEvent","OnServerEventUnreliable","OnClientEventUnreliable"}
        local callbackSeen={}
        for _,prop in ipairs(callbackProps) do
            if not callbackSeen[prop] then
                callbackSeen[prop]=true
                local ok,value=pcall(Reflection.Read, obj, prop)
                if ok and type(value)=="function" then
                    lines[#lines+1]="CALLBACK · "..prop
                    lines[#lines+1]=functionSummary901(value,prop)
                    lines[#lines+1]=""
                end
            end
        end
        if total==0 and #lines==2 then lines[#lines+1]="No live connections or callback closures were returned." end
        show901("Viewer · Event Connections",table.concat(lines,"\n"),safeFullName901(obj))
    end

