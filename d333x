	local function getClosure(scr)
		if type(env.getscriptclosure)~="function" then return nil end
		local ok,value=pcall(env.getscriptclosure,scr)
		if ok and type(value)=="function" then return value end
	end
	local function getBytecode(scr)
		local readers={env.getscriptbytecode,env.dumpstring}
		for _,reader in ipairs(readers) do
			if type(reader)=="function" then
				local ok,value=pcall(reader,scr)
				if ok and type(value)=="string" and #value>0 then return value end
			end
		end
	end
	local function decompileSource(scr)
		if type(env.decompile)~="function" then return nil,"decompile unavailable" end
		local ok,value=pcall(env.decompile,scr)
		if ok and type(value)=="string" and value~="" then return value end
		return nil,tostring(value)
	end
	local function accessorLines(closure,kind,getAll,getOne)
		local lines={}
		local seen={}
		if type(getAll)=="function" then
			local ok,all=pcall(getAll,closure)
			if ok and type(all)=="table" then
				local indexes={}
				for index in pairs(all) do if type(index)=="number" then indexes[#indexes+1]=index end end
				table.sort(indexes)
				for _,index in ipairs(indexes) do
					if index>600 then break end
					seen[index]=true
					local value=all[index]
					if type(getOne)=="function" then
						local oneOk,one=pcall(getOne,closure,index)
						if oneOk then value=one end
					end
					lines[#lines+1]=kind.."["..index.."] = "..dumpValue(value)
				end
			end
			if type(getOne)=="function" then
				for index=1,600 do
					if not seen[index] then
						local oneOk,one=pcall(getOne,closure,index)
						if oneOk and one~=nil then
							seen[index]=true
							lines[#lines+1]=kind.."["..index.."] = "..dumpValue(one)
						end
					end
				end
				table.sort(lines)
			end
			if #lines==0 then lines[1]=kind.." = {}" end
		else
			lines[1]=kind.." API unavailable"
		end
		return table.concat(lines,"\n")
	end
	Main.BuildDetailedDecompile=function(scr)
		local validTarget=false
		if scr then
			local targetOk,targetValue=pcall(function() return typeof(scr)=="Instance" and (scr:IsA("LocalScript") or scr:IsA("ModuleScript")) end)
			validTarget=targetOk and targetValue==true
		end
		if not validTarget then return nil,"DetailedDecompile requires LocalScript or ModuleScript" end
		local sections={}
		local function add(name,text) sections[#sections+1]={Name=name,Text=tostring(text or "")} end
		local fullPath=objectPath(scr)
		add("Target",table.concat({"Name = "..tostring(scr.Name),"Class = "..tostring(scr.ClassName),"Path = "..fullPath,"PlaceId = "..tostring(game.PlaceId),"GameId = "..tostring(game.GameId),"JobId = "..tostring(game.JobId)},"\n"))
		local source,sourceError=decompileSource(scr)
		add("Decompiled Source",source or "Unavailable: "..tostring(sourceError))
		local bytecode=getBytecode(scr)
		if bytecode then
			local encoded
			if type(env.base64_encode)=="function" then local ok,v=pcall(env.base64_encode,bytecode) if ok and type(v)=="string" then encoded=v end end
			add("Raw Bytecode",tostring(#bytecode).." bytes\n"..(encoded or "HEX\n"..table.concat((function() local t={} for i=1,math.min(#bytecode,4096) do t[#t+1]=string.format("%02X",string.byte(bytecode,i)) end return t end)()," ")))
		else
			add("Raw Bytecode","Unavailable")
		end
		if type(env.getscripthash)=="function" then local ok,v=pcall(env.getscripthash,scr) add("Script Hash",ok and tostring(v) or "ERROR: "..tostring(v)) end
		local closure=getClosure(scr)
		add("Closure",closure and tostring(closure) or "Unavailable")
		if closure then
			if type(env.getfunctionhash)=="function" then local ok,v=pcall(env.getfunctionhash,closure) add("Function Hash",ok and tostring(v) or "ERROR: "..tostring(v)) end
			if type(env.getinfo)=="function" then local ok,v=pcall(env.getinfo,closure) add("Function Info",ok and dumpValue(v) or "ERROR: "..tostring(v)) end
			add("Constants + getconstant",accessorLines(closure,"Constant",env.getconstants,env.getconstant))
			add("Upvalues + getupvalue",accessorLines(closure,"Upvalue",env.getupvalues,env.getupvalue))
			local protoLines={}
			if type(env.getprotos)=="function" then
				local ok,protos=pcall(env.getprotos,closure)
				if ok and type(protos)=="table" then
					for index,proto in ipairs(protos) do
						if index>600 then break end
						local text="Proto["..index.."] = "..tostring(proto)
						if type(env.getproto)=="function" then local pok,pv=pcall(env.getproto,closure,index) if pok and pv then text=text.." | getproto = "..tostring(pv) end end
						if type(env.getinfo)=="function" then local iok,iv=pcall(env.getinfo,proto) if iok and type(iv)=="table" then text=text.." | "..tostring(iv.name or "anonymous").." @ "..tostring(iv.currentline or "?") end end
						protoLines[#protoLines+1]=text
					end
				else protoLines[1]="getprotos error = "..tostring(protos) end
			else protoLines[1]="getprotos unavailable" end
			add("Nested Prototypes + getproto",table.concat(protoLines,"\n"))
			if type(env.disassemble)=="function" then
				local ok,v=pcall(env.disassemble,closure,{Recursive=true,ShowLines=true,ShowConstants=true,StringPreviewMax=256})
				if ok and type(v)=="string" and v~="" then add("Disassembler",v) else add("Disassembler","ERROR: "..tostring(v)) end
			else
				add("Disassembler","Unavailable")
			end
			local caps={}
			for _,name in ipairs({"islclosure","iscclosure","isnewcclosure","isexecutorclosure","isfunctionhooked","ishiddenstack"}) do
				if type(env[name])=="function" then local ok,v=pcall(env[name],closure) caps[#caps+1]=name.." = "..(ok and tostring(v) or "ERROR: "..tostring(v)) else caps[#caps+1]=name.." = unavailable" end
			end
			add("Closure Capabilities",table.concat(caps,"\n"))
		end
		if type(env.getscriptthread)=="function" then local ok,thread=pcall(env.getscriptthread,scr) if ok and type(thread)=="thread" then local info={"thread = "..tostring(thread)} if type(env.getthreadidentity)=="function" then local a,b=pcall(env.getthreadidentity,thread) if a then info[#info+1]="identity = "..tostring(b) end end if type(env.isourthread)=="function" then local a,b=pcall(env.isourthread,thread) if a then info[#info+1]="isourthread = "..tostring(b) end end if type(env.gettenv)=="function" then local a,b=pcall(env.gettenv,thread) if a then info[#info+1]="thread environment = "..dumpValue(b) end end add("Script Thread",table.concat(info,"\n")) end end end
		local getsenvFn = type(env)=="table" and env.getsenv or nil
		if type(getsenvFn)=="function" then
			local ok,v=pcall(function() return getsenvFn(scr) end)
			local text
			if ok then
				local dumpFn=dumpValue
				if type(dumpFn)=="function" then
					text=dumpFn(v)
				else
					text=tostring(v)
				end
			else
				text="ERROR: "..tostring(v)
			end
			if type(add)=="function" then add("Script Environment",text) end
		end
		local isModule=false
		if scr then
			local typeOk,typeValue=pcall(function() return typeof(scr)=="Instance" and scr:IsA("ModuleScript") end)
			isModule=typeOk and typeValue==true
		end
		if isModule and type(env.getmenv)=="function" then
			local ok,v=pcall(env.getmenv,scr)
			local dumpFn=dumpValue
			local text
			if ok then
				text=type(dumpFn)=="function" and dumpFn(v) or tostring(v)
			else
				text="ERROR: "..tostring(v)
			end
			if type(add)=="function" then add("Module Environment",text) end
		end
		if type(env.getgc)=="function" and closure then local ok,gc=pcall(env.getgc,false) if ok and type(gc)=="table" then local found=false for i=1,#gc do if gc[i] == closure then found=true break end end add("GC Presence",found and "Closure found in getgc(false)" or "Closure not found in getgc(false)") end end
		if not source and closure and type(env.disassemble)=="function" then local ok,v=pcall(env.disassemble,closure,{Recursive=true,ShowLines=true,ShowConstants=true,StringPreviewMax=256}) add("Decompiler Fallback",ok and tostring(v) or "Unable to disassemble: "..tostring(v)) end
		return sections,source,bytecode
	end
	Main.FormatDetailedDecompile=function(scr)
		local sections,source,bytecode=Main.BuildDetailedDecompile(scr)
		if not sections then return nil,source end
		local out={"DetailedDecompile",""}
		for _,item in ipairs(sections) do out[#out+1]="===== "..item.Name.." =====" out[#out+1]=item.Text out[#out+1]="" end
		return table.concat(out,"\n"),source,bytecode
	end
	Main.DecompileToWorkspace=function(objects)
		local scripts={}
		local seen={}
		for _,obj in ipairs(objects or {}) do
			if obj and not seen[obj] then
				local ok,isScript=pcall(function() return typeof(obj)=="Instance" and (obj:IsA("LocalScript") or obj:IsA("ModuleScript")) end)
				if ok and isScript then
					seen[obj]=true
					scripts[#scripts+1]=obj
				end
			end
		end
		if #scripts==0 then return nil,"No LocalScript or ModuleScript selected" end
		local chunks={}
		local failures={}
		for _,scr in ipairs(scripts) do
			local source,err=decompileSource(scr)
			if source then chunks[#chunks+1]=source else failures[#failures+1]=tostring(scr:GetFullName()).." => "..tostring(err) end
		end
		if type(env.makefolder)=="function" then pcall(env.makefolder,"dex") pcall(env.makefolder,"dex/decompiled") end
		if type(env.writefile)~="function" then return nil,"writefile unavailable" end
		local path
		local payload
		if #failures==0 and #chunks>0 then
			local decorated={}
			for i,scr in ipairs(scripts) do decorated[#decorated+1]="-- SCRIPT "..tostring(i).." | "..tostring(scr.ClassName).." | "..objectPath(scr).."\n"..chunks[i] end
			payload=table.concat(decorated,"\n\n")
			path="dex/decompiled/"..safeName(#scripts==1 and scripts[1].Name or "Selection").."_"..tostring(os.time())..".luau"
		else
			local fallback={"Normal decompile output",""}
			for i,scr in ipairs(scripts) do local source,err=decompileSource(scr) fallback[#fallback+1]="===== "..objectPath(scr).." =====" if source then fallback[#fallback+1]=source else local closure=getClosure(scr) if closure and type(env.disassemble)=="function" then local ok,asm=pcall(env.disassemble,closure,{Recursive=true,ShowLines=true,ShowConstants=true,StringPreviewMax=256}) fallback[#fallback+1]="Decompile unavailable: "..tostring(err) fallback[#fallback+1]="Disassembly fallback:" fallback[#fallback+1]=ok and tostring(asm) or tostring(asm) else fallback[#fallback+1]="Decompile unavailable: "..tostring(err) end end fallback[#fallback+1]="" end
			payload=table.concat(fallback,"\n")
			path="dex/decompiled/"..safeName(#scripts==1 and scripts[1].Name or "Selection").."_"..tostring(os.time()).."_fallback.txt"
		end
		local ok,err=pcall(env.writefile,path,payload)
		if not ok then return nil,tostring(err) end
		return path,payload
	end
	Main.DetailedDecompile=function(objects)
