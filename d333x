    local function resolveClosure(obj)
        if not obj then return nil,"No target selected" end
        local getter = env and env.getscriptclosure or rawget(_G,"getscriptclosure")
        if type(getter) ~= "function" then return nil,"getscriptclosure unavailable" end
        local ok,closure = pcall(getter,obj)
        if ok and type(closure) == "function" then return closure end
        return nil,ok and "No closure returned" or tostring(closure)
    end

    local function closureReport(closure,owner)
        local lines = {}
        lines[#lines+1] = "TARGET"
        local ownerName = tostring(owner or closure)
        if owner then
            local okOwner, full = pcall(function() return owner:GetFullName() end)
            if okOwner and full then ownerName = tostring(full) end
        end
        lines[#lines+1] = "  "..ownerName
        lines[#lines+1] = ""

        local okInfo,info,errInfo = getApi("getinfo",closure)
        lines[#lines+1] = "FUNCTION INFO"
        lines[#lines+1] = okInfo and inspect(info) or "ERROR: "..tostring(errInfo)
        lines[#lines+1] = ""

        for _,spec in ipairs({
            {"CONSTANTS","getconstants","getconstant","Constant"},
            {"UPVALUES","getupvalues","getupvalue","Upvalue"},
            {"PROTOTYPES","getprotos","getproto","Proto"},
        }) do
            local heading,allName,oneName,itemName = table.unpack(spec)
            lines[#lines+1] = heading
            local okAll,allValue = getApi(allName,closure)
            if okAll and type(allValue) == "table" then
                local keys = {}
                for key in pairs(allValue) do if type(key) == "number" then keys[#keys+1] = key end end
                table.sort(keys)
                for _,index in ipairs(keys) do
                    local okOne,oneValue = getApi(oneName,closure,index)
                    local value = okOne and oneValue or allValue[index]
                    lines[#lines+1] = "  "..itemName.."["..tostring(index).."] = "..Main.FormatInspectValue(value,0,{})
                end
            else
                lines[#lines+1] = "  "..(okAll and Main.FormatInspectValue(allValue,0,{}) or "ERROR: "..tostring(select(3,getApi(allName,closure))))
            end
            lines[#lines+1] = ""
        end

        lines[#lines+1] = "CAPABILITIES"
        for _,name in ipairs({"islclosure","iscclosure","isnewcclosure","isexecutorclosure","isfunctionhooked","ishiddenstack"}) do
            local ok,value,err = getApi(name,closure)
            lines[#lines+1] = "  "..name.." = "..(ok and tostring(value) or "ERROR: "..tostring(err))
        end
        lines[#lines+1] = ""

        local okDis,dis,errDis = getApi("disassemble",closure,{Recursive=true,ShowLines=true,ShowConstants=true,StringPreviewMax=256})
        lines[#lines+1] = "DISASSEMBLER"
        lines[#lines+1] = okDis and tostring(dis) or "ERROR: "..tostring(errDis)

        if Settings.Explorer.DeepRuntimeInspection then
            lines[#lines+1] = ""
            lines[#lines+1] = "DEEP RUNTIME"
            local okReg,reg,regErr = getApi("getreg")
            lines[#lines+1] = "REGISTRY = "..(okReg and Main.FormatInspectValue(reg,0,{}) or "ERROR: "..tostring(regErr))
            local okGc,gc,gcErr = getApi("getgc",false)
            lines[#lines+1] = "GC OBJECTS = "..(okGc and tostring(type(gc)=="table" and #gc or 0) or "ERROR: "..tostring(gcErr))
        end
        return table.concat(lines,"\n")
    end

